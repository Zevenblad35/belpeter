---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  stad: string;
  dienst: 'social-media' | 'website';
  canonical: string;
}

const { title, description, stad, dienst, canonical } = Astro.props;
---

<Layout title={title} description={description}>
  <!-- LocalBusiness structured data voor lokale SEO -->
  <script type="application/ld+json" slot="head">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Bel Peter",
      "description": description,
      "url": `https://belpeter.nl${canonical}`,
      "telephone": "+31851155136",
      "email": "peter@belpeter.nl",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Nijverdal",
        "addressRegion": "Overijssel",
        "addressCountry": "NL"
      },
      "areaServed": {
        "@type": "City",
        "name": stad
      },
      "serviceType": dienst === 'social-media' ? 'Social Media Beheer' : 'Website Ontwikkeling',
      "priceRange": "€€"
    })}
  </script>
  <slot />
</Layout>
