---
export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
}
const {
  title,
  description = "Peter Rutgers helpt ondernemers in Twente om online op te vallen. Social media beheer en websites op maat. Gratis kennismaking.",
  canonical = "https://belpeter.nl/",
  image = "/og-image.jpg",
} = Astro.props;
const path = Astro.url.pathname;
---
<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="canonical" href={canonical}/>
  <meta property="og:title" content={title}/>
  <meta property="og:description" content={description}/>
  <meta property="og:image" content={image}/>
  <meta property="og:type" content="website"/>
  <meta property="og:url" content={canonical}/>
  <meta name="twitter:card" content="summary_large_image"/>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/styles/global.css"/>
</head>
<body>

<!-- TOPBAR -->
<div class="topbar">
  <span class="topbar-loc">📍 Nijverdal · Almelo · Hengelo · Enschede & heel Twente</span>
  <a href="tel:+31851155136">085 115 5136</a>
</div>

<!-- NAVBAR -->
<header class="navbar" id="navbar">
  <a href="/" class="logo">BelPeter</a>
  <nav class="nav-links" aria-label="Hoofdnavigatie">
    <div class="nav-dd">
      <a href="/diensten">Diensten ▾</a>
      <div class="dropdown">
        <a href="/diensten/social-media"><strong>Social Media</strong><span>Strategie & contentcreatie</span></a>
        <a href="/diensten/websites"><strong>Websites</strong><span>Op maat gemaakte websites</span></a>
        <a href="/diensten/fotografie"><strong>Fotografie</strong><span>Professionele bedrijfsfotografie</span></a>
      </div>
    </div>
    <a href="/over" class={path==='/over/'||path==='/over'?'active':''}>Over Peter</a>
    <a href="/blog" class={path.startsWith('/blog')?'active':''}>Blog</a>
    <a href="/contact" class={path==='/contact/'||path==='/contact'?'active':''}>Contact</a>
  </nav>
  <a href="/contact" class="btn btn-dark nav-cta">Gratis kennismaking</a>
  <button class="hamburger" aria-label="Menu" aria-expanded="false" onclick="toggleMenu(this)">
    <span></span><span></span><span></span>
  </button>
</header>

<!-- MOBILE MENU -->
<nav id="mobile-menu" class="mobile-menu">
  <a href="/diensten/social-media">Social Media</a>
  <a href="/diensten/websites">Websites</a>
  <a href="/diensten/fotografie">Fotografie</a>
  <a href="/over">Over Peter</a>
  <a href="/blog">Blog</a>
  <a href="/contact">Contact</a>
  <a href="/contact" class="btn btn-primary" style="margin-top:12px;justify-content:center">Gratis kennismaking</a>
</nav>

<main><slot/></main>

<!-- GLOBAL CTA BAND -->
<section class="cta-band">
  <div class="cta-deco" aria-hidden="true">
    <img src="https://www.peterrutgersmedia.nl/wp-content/uploads/2025/11/peter-metcamera-1024x747.jpg" alt="" width="220" height="260" loading="lazy"/>
  </div>
  <div class="container">
    <div class="cta-card">
      <div class="cta-copy">
        <h2>Klaar om zichtbaarder<br>te worden in Twente?</h2>
        <p>Bel Peter of plan een gratis kennismaking. Vrijblijvend, gewoon een goed gesprek.</p>
      </div>
      <div class="cta-btns">
        <a href="tel:+31851155136" class="btn btn-dark">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          085 115 5136
        </a>
        <a href="/contact" class="btn btn-primary">Plan kennismaking</a>
      </div>
    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="footer">
  <div class="footer-inner">
    <div class="f-brand">
      <a href="/" class="f-logo">BelPeter</a>
      <p>Peter Rutgers — jouw zichtbaarheidspartner in Twente. Social media en websites die je laten opvallen.</p>
      <div class="f-contact">
        <a href="tel:+31851155136">085 115 5136</a>
        <span>·</span>
        <a href="mailto:peter@belpeter.nl">peter@belpeter.nl</a>
      </div>
      <div class="f-social">
        <a href="https://instagram.com/belpeter.nl" aria-label="Instagram" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/></svg>
        </a>
        <a href="https://linkedin.com/in/peterrutgers" aria-label="LinkedIn" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </div>
    <nav class="f-nav">
      <div class="f-col"><h5>Diensten</h5>
        <a href="/diensten/fotografie">Fotografie</a>
        <a href="/diensten/social-media">Social Media</a>
        <a href="/diensten/websites">Websites</a>
        <a href="/diensten">Alle diensten</a>
      </div>
      <div class="f-col"><h5>Werkgebied</h5>
        <a href="/social-media-nijverdal">Nijverdal</a>
        <a href="/social-media-almelo">Almelo & Wierden</a>
        <a href="/social-media-hengelo">Hengelo & Rijssen</a>
        <a href="/social-media-enschede">Enschede</a>
        <a href="/website-laten-maken-twente">Heel Twente</a>
      </div>
      <div class="f-col"><h5>Bedrijf</h5>
        <a href="/over">Over Peter</a>
        <a href="/blog">Blog</a>
        <a href="/contact">Contact</a>
        <a href="/contact">Kennismaking plannen</a>
      </div>
      <div class="f-col"><h5>Probeer BelPeter</h5>
        <p style="font-size:13px;color:#9ca3af;margin-bottom:12px;line-height:1.5">Plan een gratis kennismaking. Vrijblijvend — gewoon een goed gesprek.</p>
        <form class="f-form" action="/contact" method="get">
          <input type="email" name="email" placeholder="jouw e-mail" aria-label="E-mailadres"/>
          <button type="submit" aria-label="Versturen">→</button>
        </form>
      </div>
    </nav>
  </div>
  <div class="f-bottom">
    <span>© 2026 Bel Peter · Nijverdal</span>
    <div class="f-legal">
      <a href="/privacy">Privacybeleid</a>
      <a href="/algemene-voorwaarden">Algemene voorwaarden</a>
    </div>
  </div>
</footer>

<script>
function toggleMenu(btn) {
  const m = document.getElementById('mobile-menu');
  const open = m.classList.toggle('open');
  btn.setAttribute('aria-expanded', String(open));
}
document.addEventListener('click', e => {
  const m = document.getElementById('mobile-menu');
  const n = document.getElementById('navbar');
  if (!n.contains(e.target) && !m.contains(e.target)) m.classList.remove('open');
});
</script>
</body>
</html>

<style>
.topbar{background:#1a1a1a;color:#d1d5db;font-size:13px;display:flex;justify-content:space-between;align-items:center;padding:7px 24px}
.topbar a{color:#F5C518;font-weight:600}
.navbar{background:#F5C518;display:flex;align-items:center;gap:2rem;padding:0 32px;height:var(--nav-h);position:sticky;top:0;z-index:200;box-shadow:0 2px 8px rgba(0,0,0,.08)}
.logo{font-size:22px;font-weight:900;color:#1a1a1a;letter-spacing:-.5px;white-space:nowrap}
.nav-links{display:flex;align-items:center;margin:0 auto}
.nav-links > a,.nav-dd > a{padding:8px 16px;font-size:15px;font-weight:500;color:#1a1a1a;border-radius:var(--r-sm);transition:background .15s}
.nav-links > a:hover,.nav-dd > a:hover,.nav-links > a.active{background:rgba(0,0,0,.08)}
.nav-dd{position:relative}
.dropdown{display:none;position:absolute;top:calc(100% + 8px);left:0;background:#fff;border-radius:var(--r-md);box-shadow:var(--sh-md);padding:8px;min-width:240px;z-index:300}
.nav-dd:hover .dropdown{display:flex;flex-direction:column;gap:2px}
.dropdown a{display:flex;flex-direction:column;padding:10px 14px;border-radius:var(--r-sm);font-size:14px;transition:background .15s}
.dropdown a:hover{background:var(--gray-100)}
.dropdown a strong{font-size:14px;font-weight:600;color:#1a1a1a}
.dropdown a span{font-size:12px;color:var(--gray-500);margin-top:2px}
.nav-cta{margin-left:0}
.hamburger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:4px;margin-left:auto}
.hamburger span{display:block;width:24px;height:2px;background:#1a1a1a;border-radius:2px}
.mobile-menu{display:none;position:fixed;top:calc(var(--nav-h) + 35px);left:0;right:0;background:#fff;padding:20px 24px;flex-direction:column;gap:4px;box-shadow:var(--sh-md);z-index:199}
.mobile-menu.open{display:flex}
.mobile-menu a{padding:12px 0;font-size:16px;font-weight:500;border-bottom:.5px solid var(--gray-200)}

.cta-band{background:#F5C518;padding:0;position:relative;overflow:hidden;min-height:200px}
.cta-deco{position:absolute;bottom:0;left:50%;transform:translateX(-50%);pointer-events:none}
.cta-deco img{height:280px;width:auto;object-fit:cover;object-position:top;border-radius:200px 200px 0 0;opacity:.2}
.cta-band .container{position:relative;z-index:1;padding-top:72px;padding-bottom:72px}
.cta-card{background:#fff;border-radius:var(--r-xl);padding:48px 52px;display:flex;align-items:center;justify-content:space-between;gap:32px;box-shadow:var(--sh-lg);flex-wrap:wrap}
.cta-copy h2{font-size:clamp(24px,3vw,36px);margin-bottom:8px}
.cta-copy p{font-size:16px}
.cta-btns{display:flex;gap:12px;flex-wrap:wrap;flex-shrink:0}

.footer{background:#111827;color:#9ca3af;padding:64px 32px 32px}
.footer-inner{max-width:var(--max-w);margin:0 auto;display:grid;grid-template-columns:260px 1fr;gap:64px;margin-bottom:48px}
.f-logo{font-size:20px;font-weight:900;color:#fff;display:block;margin-bottom:14px;letter-spacing:-.5px}
.f-brand p{font-size:14px;line-height:1.65;margin-bottom:16px}
.f-contact{display:flex;align-items:center;gap:8px;font-size:14px;margin-bottom:16px}
.f-contact a{color:#F5C518;font-weight:600}
.f-social{display:flex;gap:12px}
.f-social a{color:#9ca3af;transition:color .15s}
.f-social a:hover{color:#F5C518}
.f-nav{display:grid;grid-template-columns:repeat(4,1fr);gap:32px}
.f-col h5{font-size:12px;font-weight:700;color:#fff;text-transform:uppercase;letter-spacing:.08em;margin-bottom:14px}
.f-col a{display:block;font-size:14px;color:#9ca3af;margin-bottom:8px;transition:color .15s}
.f-col a:hover{color:#fff}
.f-form{display:flex;gap:8px;margin-top:8px}
.f-form input{flex:1;padding:10px 14px;border-radius:var(--r-sm);border:1px solid rgba(255,255,255,.15);background:rgba(255,255,255,.07);color:#fff;font-size:14px;font-family:inherit}
.f-form input::placeholder{color:#6b7280}
.f-form button{background:#2563EB;color:#fff;border:none;border-radius:50%;width:40px;height:40px;font-size:18px;cursor:pointer;transition:background .15s;font-family:inherit}
.f-form button:hover{background:#1d4ed8}
.f-bottom{max-width:var(--max-w);margin:0 auto;padding-top:24px;border-top:1px solid rgba(255,255,255,.08);display:flex;justify-content:space-between;align-items:center;font-size:13px;flex-wrap:wrap;gap:8px}
.f-legal{display:flex;gap:20px}
.f-legal a{color:#9ca3af}
.f-legal a:hover{color:#fff}

@media(max-width:900px){
  .nav-links,.nav-cta{display:none}
  .hamburger{display:flex}
  .footer-inner{grid-template-columns:1fr;gap:32px}
  .f-nav{grid-template-columns:1fr 1fr;gap:24px}
  .cta-card{flex-direction:column;align-items:flex-start;padding:32px}
  .topbar-loc{display:none}
}
@media(max-width:560px){
  .f-nav{grid-template-columns:1fr}
}
</style>
