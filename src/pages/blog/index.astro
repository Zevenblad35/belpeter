---
import Layout from '../../layouts/Layout.astro';

const posts = [
  {
    slug: 'waarom-professionele-fotos-meer-klanten-opleveren',
    title: 'Waarom professionele foto\'s meer klanten opleveren',
    excerpt: 'Mensen kopen van mensen die ze vertrouwen. Professionele beelden bouwen dat vertrouwen eerder op dan welke tekst dan ook.',
    category: 'Fotografie',
    date: '15 april 2025',
    readtime: '4 min'
  },
  {
    slug: 'instagram-voor-bedrijven-zo-begin-je',
    title: 'Instagram voor bedrijven: zo begin je goed',
    excerpt: 'Instagram is voor veel bedrijven het meest effectieve social media kanaal. Maar hoe zet je het goed in? Dit zijn de eerste stappen.',
    category: 'Social Media',
    date: '8 maart 2025',
    readtime: '6 min'
  },
  {
    slug: 'website-seo-5-dingen-die-je-nu-kunt-doen',
    title: '5 SEO-verbeteringen die je website direct vindbaar maken',
    excerpt: 'Je hoeft geen SEO-expert te zijn om je website beter vindbaar te maken. Deze 5 aanpassingen kun je vandaag nog doorvoeren.',
    category: 'Websites',
    date: '22 februari 2025',
    readtime: '5 min'
  },
  {
    slug: 'online-zichtbaarheid-beginnen',
    title: 'Online zichtbaarheid: waar begin je als ondernemer?',
    excerpt: 'Veel ondernemers weten dat ze zichtbaarder moeten worden, maar weten niet waar ze moeten beginnen. Dit is de aanpak die werkt.',
    category: 'Strategie',
    date: '10 januari 2025',
    readtime: '7 min'
  },
];
---

<Layout
  title="Blog — Tips over fotografie, social media & websites | Bel Peter"
  description="Lees praktische tips over fotografie, social media en websites. Peter deelt zijn kennis om jouw bedrijf zichtbaarder te maken."
>

  <section class="blog-hero">
    <div class="container">
      <span class="tag">Blog</span>
      <h1>Kennis & tips voor<br />meer zichtbaarheid</h1>
      <p>Peter deelt praktische inzichten over fotografie, social media en websites. Gratis te lezen, direct toepasbaar.</p>
    </div>
  </section>

  <section class="blog-posts">
    <div class="container">
      <div class="posts-grid">
        {posts.map((post, i) => (
          <a href={`/blog/${post.slug}`} class={`post-card ${i === 0 ? 'post-card-featured' : ''}`}>
            <div class="post-img" style={`background: linear-gradient(135deg, var(--dark), var(--forest));`}>
              <span class="post-category-badge">{post.category}</span>
            </div>
            <div class="post-body">
              <div class="post-meta">
                <span class="post-date">{post.date}</span>
                <span class="post-dot">·</span>
                <span class="post-read">{post.readtime} lezen</span>
              </div>
              <h2 class="post-title">{post.title}</h2>
              <p class="post-excerpt">{post.excerpt}</p>
              <span class="post-link">
                Lees meer
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="newsletter-section">
    <div class="container">
      <div class="newsletter-inner">
        <div class="newsletter-text">
          <h2>Mis geen enkel inzicht</h2>
          <p>Ontvang maandelijks praktische tips van Peter in je inbox. Geen spam, altijd relevante content.</p>
        </div>
        <form class="newsletter-form">
          <input type="email" placeholder="jouw@email.nl" />
          <button type="submit" class="btn btn-primary">Aanmelden</button>
        </form>
      </div>
    </div>
  </section>

</Layout>

<style>
.blog-hero {
  background: var(--dark);
  color: var(--white);
  padding: 72px 0;
  text-align: center;
}

.blog-hero .tag { background: rgba(21,186,179,0.2); color: var(--teal); margin-bottom: 20px; display: inline-block; }
.blog-hero h1 { font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; color: var(--white); margin-bottom: 16px; letter-spacing: -0.03em; }
.blog-hero p { color: rgba(255,255,255,0.7); max-width: 500px; margin: 0 auto; font-size: 1.05rem; line-height: 1.7; }

.blog-posts { padding: 80px 0; }

.posts-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.post-card {
  background: var(--white);
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 1px solid var(--gray-mid);
  display: block;
  color: var(--dark);
  text-decoration: none;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.post-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 20px 48px rgba(0,0,0,0.1);
}

.post-card-featured {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: 1fr 1fr;
}

.post-card-featured .post-img { height: 100%; min-height: 240px; }

.post-img {
  height: 200px;
  position: relative;
  display: flex;
  align-items: flex-start;
  padding: 16px;
}

.post-category-badge {
  background: rgba(21,186,179,0.9);
  color: var(--white);
  padding: 4px 12px;
  border-radius: 100px;
  font-size: 0.75rem;
  font-weight: 700;
}

.post-body { padding: 24px; }

.post-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.78rem;
  color: var(--gray-text);
  margin-bottom: 10px;
}

.post-dot { color: var(--gray-mid); }

.post-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 10px; line-height: 1.3; }
.post-card-featured .post-title { font-size: 1.4rem; }

.post-excerpt { font-size: 0.88rem; color: var(--gray-text); line-height: 1.6; margin-bottom: 16px; }

.post-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--teal);
}

.newsletter-section { background: var(--gray-light); }

.newsletter-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
}

.newsletter-text h2 { font-size: 1.6rem; font-weight: 800; margin-bottom: 8px; letter-spacing: -0.02em; }
.newsletter-text p { color: var(--gray-text); }

.newsletter-form {
  display: flex;
  gap: 12px;
  flex-shrink: 0;
}

.newsletter-form input {
  padding: 12px 16px;
  border: 1.5px solid var(--gray-mid);
  border-radius: var(--radius);
  font-size: 0.9rem;
  font-family: var(--font-body);
  outline: none;
  width: 240px;
}

.newsletter-form input:focus { border-color: var(--teal); }

@media (max-width: 900px) {
  .posts-grid { grid-template-columns: 1fr; }
  .post-card-featured { grid-column: auto; grid-template-columns: 1fr; }
  .newsletter-inner { flex-direction: column; }
  .newsletter-form { flex-direction: column; width: 100%; }
  .newsletter-form input { width: 100%; }
}
</style>
