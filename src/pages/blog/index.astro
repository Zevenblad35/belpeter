---
import Layout from '../../layouts/Layout.astro';

const posts = [
  { slug: 'waarom-professionele-fotos-meer-klanten', title: "Waarom professionele foto's meer klanten opleveren", excerpt: "Mensen kopen van mensen die ze vertrouwen. Professionele beelden bouwen dat vertrouwen eerder op dan welke tekst dan ook.", cat: 'Fotografie', date: '15 april 2025', min: '4' },
  { slug: 'instagram-voor-twentse-ondernemers', title: 'Instagram voor Twentse ondernemers: zo begin je goed', excerpt: 'Instagram is voor veel lokale bedrijven het meest effectieve social media kanaal. Dit zijn de eerste stappen.', cat: 'Social Media', date: '8 maart 2025', min: '6' },
  { slug: 'website-seo-twente', title: '5 SEO-tips die je website in Twente vindbaar maken', excerpt: 'Je hoeft geen expert te zijn om je website beter vindbaar te maken voor lokale klanten in Twente en Overijssel.', cat: 'Websites', date: '22 feb 2025', min: '5' },
  { slug: 'online-zichtbaarheid-beginnen', title: 'Online zichtbaarheid: waar begin je als Twentse ondernemer?', excerpt: 'Veel ondernemers weten dat ze zichtbaarder moeten worden, maar weten niet waar ze moeten beginnen.', cat: 'Strategie', date: '10 jan 2025', min: '7' },
];

const catColors: Record<string, string> = {
  'Fotografie': 'var(--teal)',
  'Social Media': 'var(--yellow)',
  'Websites': 'var(--sky)',
  'Strategie': 'var(--forest)',
};
---
<Layout
  title="Blog — Zichtbaarheidstips voor Twentse Ondernemers | Bel Peter"
  description="Lees praktische tips over fotografie, social media en websites voor ondernemers in Twente. Peter Rutgers deelt zijn kennis gratis."
>
  <section style="background:var(--dark);padding:80px 0;text-align:center;">
    <div class="container">
      <span class="tag" style="background:rgba(21,186,179,0.2);color:var(--teal);margin-bottom:16px;display:inline-block;">Blog</span>
      <h1 style="font-size:clamp(2rem,4vw,3rem);font-weight:800;color:var(--white);letter-spacing:-0.03em;margin-bottom:16px;">Zichtbaarheidstips voor<br /><span style="color:var(--yellow)">Twentse ondernemers</span></h1>
      <p style="color:rgba(255,255,255,0.7);max-width:480px;margin:0 auto;font-size:1.05rem;line-height:1.7;">Peter deelt praktische inzichten over fotografie, social media en websites. Gratis te lezen, direct toepasbaar in Twente.</p>
    </div>
  </section>

  <section style="background:var(--teal);padding:14px 0;">
    <div class="container" style="display:flex;justify-content:center;gap:24px;flex-wrap:wrap;">
      {['Fotografie','Social Media','Websites','Strategie'].map(cat => (
        <span style={`background:rgba(255,255,255,0.15);color:var(--white);padding:5px 16px;border-radius:100px;font-size:0.8rem;font-weight:700;cursor:pointer;`}>{cat}</span>
      ))}
    </div>
  </section>

  <section>
    <div class="container">
      <div class="blog-grid">
        {posts.map((post, i) => (
          <a href={`/blog/${post.slug}`} class={`blog-card ${i === 0 ? 'blog-card-hero' : ''}`}>
            <div class="blog-img" style={`background:linear-gradient(135deg, var(--dark), var(--forest));`}>
              <span class="blog-cat" style={`background:${catColors[post.cat]};color:${post.cat === 'Social Media' ? 'var(--dark)' : 'var(--white)'}`}>{post.cat}</span>
            </div>
            <div class="blog-body">
              <div class="blog-meta">
                <span>{post.date}</span>
                <span>·</span>
                <span>{post.min} min lezen</span>
              </div>
              <h2 class="blog-title">{post.title}</h2>
              <p class="blog-excerpt">{post.excerpt}</p>
              <span class="blog-lees">Lees meer →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section style="background:var(--yellow);padding:64px 0;">
    <div class="container nieuws-inner">
      <div>
        <h2 style="font-size:1.8rem;font-weight:800;color:var(--dark);letter-spacing:-0.02em;margin-bottom:8px;">Geen tip missen?</h2>
        <p style="color:rgba(20,18,19,0.7);">Ontvang maandelijks zichtbaarheidstips van Peter in je inbox.</p>
      </div>
      <form class="nieuws-form">
        <input type="email" placeholder="jouw@email.nl" />
        <button type="submit" class="btn btn-teal">Aanmelden</button>
      </form>
    </div>
  </section>
</Layout>

<style>
.blog-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
.blog-card { border-radius: var(--radius-lg); overflow: hidden; background: var(--white); border: 2px solid var(--gray-light); display: block; color: var(--dark); transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s; }
.blog-card:hover { transform: translateY(-5px); box-shadow: 0 20px 48px rgba(0,0,0,0.1); border-color: var(--teal); }
.blog-card-hero { grid-column: 1 / -1; display: grid; grid-template-columns: 1.2fr 1fr; }
.blog-card-hero .blog-img { min-height: 260px; }
.blog-img { height: 200px; position: relative; display: flex; align-items: flex-start; padding: 16px; }
.blog-cat { padding: 5px 14px; border-radius: 100px; font-size: 0.75rem; font-weight: 700; }
.blog-body { padding: 24px; }
.blog-meta { display: flex; gap: 6px; font-size: 0.78rem; color: var(--gray-text); margin-bottom: 10px; }
.blog-title { font-size: 1.1rem; font-weight: 800; margin-bottom: 10px; line-height: 1.3; letter-spacing: -0.02em; }
.blog-card-hero .blog-title { font-size: 1.4rem; }
.blog-excerpt { font-size: 0.88rem; color: var(--gray-text); line-height: 1.65; margin-bottom: 16px; }
.blog-lees { font-size: 0.85rem; font-weight: 700; color: var(--teal); font-family: var(--font-display); }
.nieuws-inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; }
.nieuws-form { display: flex; gap: 12px; flex-shrink: 0; }
.nieuws-form input { padding: 12px 18px; border: 2px solid rgba(20,18,19,0.2); border-radius: 100px; font-size: 0.9rem; font-family: var(--font-body); outline: none; width: 240px; }
.nieuws-form input:focus { border-color: var(--dark); }
@media (max-width: 900px) {
  .blog-grid { grid-template-columns: 1fr; }
  .blog-card-hero { grid-template-columns: 1fr; }
  .nieuws-inner { flex-direction: column; }
  .nieuws-form { flex-direction: column; width: 100%; }
  .nieuws-form input { width: 100%; }
}
</style>
