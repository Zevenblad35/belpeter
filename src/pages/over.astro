---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Over Peter Rutgers — Zichtbaarheidspartner in Twente | Bel Peter"
  description="Leer Peter Rutgers kennen uit Nijverdal. Fotograaf, social media specialist en websitebouwer. Jouw zichtbaarheidspartner in Twente en Overijssel."
>
  <section class="over-hero">
    <div class="over-hero-bg">
      <img src="https://www.peterrutgersmedia.nl/wp-content/uploads/2025/11/peter-metcamera-1024x747.jpg" alt="Peter Rutgers Nijverdal" onerror="this.style.display='none'"/>
      <div class="over-overlay"></div>
    </div>
    <div class="container over-hero-inner">
      <div class="over-hero-content">
        <span class="tag" style="background:rgba(255,240,1,0.2);color:var(--yellow);">Over Peter</span>
        <h1 style="font-size:clamp(2.2rem,5vw,4rem);font-weight:800;color:var(--white);letter-spacing:-0.03em;margin:16px 0 20px;">Peter Rutgers.<br /><span style="color:var(--teal)">Jouw zichtbaarheids-<br />partner in Twente.</span></h1>
        <p style="color:rgba(255,255,255,0.8);max-width:500px;font-size:1.05rem;line-height:1.75;">Fotograaf, social media specialist en websitebouwer vanuit Nijverdal. Ik help bedrijven in Twente om op te vallen — online én offline.</p>
      </div>
      <div class="over-hero-stats">
        {[
          { val: '2+', lbl: 'Jaar ervaring', kleur: 'var(--teal)' },
          { val: 'Twente', lbl: 'Jouw regio', kleur: 'var(--yellow)' },
          { val: 'Twente', lbl: 'Thuis & werkgebied', kleur: 'var(--sky)' },
        ].map(s => (
          <div class="ohs-item">
            <span class="ohs-val" style={`color:${s.kleur}`}>{s.val}</span>
            <span class="ohs-lbl">{s.lbl}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="background:var(--teal-light);">
    <div class="container over-split">
      <div class="over-img-wrap">
        <div class="over-img-frame">
          <img src="https://www.peterrutgersmedia.nl/wp-content/uploads/2025/11/peter-metcamera-1024x747.jpg" alt="Peter aan het werk" onerror="this.parentElement.style.background='var(--teal)'"/>
        </div>
        <div class="over-img-label">
          <span>📍 Nijverdal, Twente</span>
        </div>
      </div>
      <div class="over-verhaal">
        <span class="tag">Mijn verhaal</span>
        <h2>Echte beelden,<br />echte verhalen</h2>
        <p>Ik ben <strong>Peter Rutgers</strong> — geboren en getogen in Nijverdal. Ik leg échte momenten vast en help ondernemers in Twente om online op te vallen.</p>
        <p>Ik combineer fotografie, social media en websites om jouw online zichtbaarheid compleet te maken. Via <strong>Bel Peter</strong> help ik ondernemers in Twente met hun volledige aanpak: van prachtige beelden tot een vindbare website en actieve social media.</p>
        <p>Ik weet hoe ondernemers in Twente werken. Ik ken de regio, de mensen en de mentaliteit. Dat maakt samenwerken makkelijker én persoonlijker.</p>
        <div class="over-dienst-tags">
          <span style="background:var(--teal);color:var(--white);padding:6px 16px;border-radius:100px;font-size:0.82rem;font-weight:700;">📸 Fotografie</span>
          <span style="background:var(--yellow);color:var(--dark);padding:6px 16px;border-radius:100px;font-size:0.82rem;font-weight:700;">📱 Social Media</span>
          <span style="background:var(--sky);color:var(--dark);padding:6px 16px;border-radius:100px;font-size:0.82rem;font-weight:700;">💻 Websites</span>
        </div>
        <a href="/contact" class="btn btn-teal" style="margin-top:8px;">Kennismaken met Peter</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header">
        <span class="tag">Hoe Peter werkt</span>
        <h2>Persoonlijk, eerlijk<br />en resultaatgericht</h2>
      </div>
      <div class="waarden-grid">
        {[
          { kleur: 'var(--teal)', icon: '🎯', title: 'Resultaatgericht', desc: 'Geen losse acties, maar een samenhangende aanpak die bijdraagt aan jouw doelen.' },
          { kleur: 'var(--yellow)', icon: '🤝', title: 'Persoonlijk contact', desc: 'Je werkt direct met Peter. Geen tussenpersonen, geen vertraagde communicatie.' },
          { kleur: 'var(--sky)', icon: '💬', title: 'Eerlijk advies', desc: 'Peter vertelt je wat hij denkt — ook als dat niet altijd is wat je wil horen.' },
          { kleur: 'var(--teal)', icon: '📍', title: 'Lokale kennis', desc: 'Als Twentenaar kent Peter de regio, de mensen en de lokale ondernemersmentaliteit.' },
          { kleur: 'var(--yellow)', icon: '🔗', title: 'Alles in samenhang', desc: 'Foto\'s voor je website die ook op social werken. Consistentie in elk kanaal.' },
          { kleur: 'var(--sky)', icon: '📈', title: 'Langdurig betrokken', desc: 'Geen eenmalige transactie, maar een partner die meegroeit met jouw bedrijf.' },
        ].map(w => (
          <div class="waarde-card">
            <div class="wc-icon" style={`background:${w.kleur};color:${w.kleur === 'var(--teal)' ? 'var(--white)' : 'var(--dark)'}`}>{w.icon}</div>
            <h3>{w.title}</h3>
            <p>{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="background:var(--dark);">
    <div class="container">
      <div class="section-header">
        <span class="tag" style="background:rgba(21,186,179,0.2);color:var(--teal);">Klanten aan het woord</span>
        <h2 style="color:var(--white);">Wat Twentse ondernemers<br />over Peter zeggen</h2>
      </div>
      <div class="reviews-grid-over">
        {[
          { av: 'JB', avkleur: 'var(--teal)', name: 'Janneke Bakker', bedrijf: 'Bakker & Zn. · Nijverdal', quote: '"Peter heeft onze zichtbaarheid enorm vergroot. De foto\'s, de website én de social media passen nu perfect bij wie we zijn."' },
          { av: 'TM', avkleur: 'var(--yellow)', name: 'Thomas Meijer', bedrijf: 'MT Advies · Almelo', quote: '"Eindelijk een website die gevonden wordt. Peter is altijd snel te bereiken en denkt écht met je mee."' },
          { av: 'LV', avkleur: 'var(--sky)', name: 'Lisa van Dijk', bedrijf: 'Studio Linde · Hengelo', quote: '"De foto\'s die Peter heeft gemaakt zijn prachtig. Echt een investering die zijn geld waard is."' },
        ].map(r => (
          <div class="review-over-card">
            <div class="roc-stars">★★★★★</div>
            <p class="roc-quote">{r.quote}</p>
            <div class="roc-author">
              <div class="roc-av" style={`background:${r.avkleur};color:${r.avkleur === 'var(--teal)' ? 'var(--white)' : 'var(--dark)'}`}>{r.av}</div>
              <div>
                <strong style="color:var(--white);font-size:0.9rem;">{r.name}</strong>
                <span style="display:block;font-size:0.78rem;color:rgba(255,255,255,0.45);">{r.bedrijf}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-text">
          <h2>Zin om samen te werken?</h2>
          <p>Plan een gratis kennismaking. Peter staat klaar voor ondernemers in Twente.</p>
        </div>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">Maak een afspraak</a>
          <a href="/diensten/fotografie" class="btn btn-outline-white">Bekijk fotografie →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
.over-hero { position: relative; min-height: 80vh; display: flex; align-items: flex-end; overflow: hidden; }
.over-hero-bg { position: absolute; inset: 0; }
.over-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
.over-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(20,18,19,0.92) 0%, rgba(20,18,19,0.5) 70%, rgba(20,18,19,0.2) 100%); }
.over-hero-inner { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; padding-bottom: 64px; }
.over-hero-stats { display: flex; flex-direction: column; gap: 20px; flex-shrink: 0; }
.ohs-item { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: var(--radius-lg); padding: 18px 28px; min-width: 180px; }
.ohs-val { display: block; font-family: var(--font-display); font-weight: 800; font-size: 1.8rem; }
.ohs-lbl { display: block; font-size: 0.78rem; color: rgba(255,255,255,0.5); margin-top: 2px; }

.over-split { display: grid; grid-template-columns: 1fr 1.4fr; gap: 64px; align-items: center; }
.over-img-frame { border-radius: var(--radius-lg); overflow: hidden; border: 4px solid var(--teal); aspect-ratio: 4/5; position: relative; }
.over-img-frame img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
.over-img-wrap { position: relative; }
.over-img-label { position: absolute; bottom: -12px; right: -12px; background: var(--yellow); color: var(--dark); padding: 10px 18px; border-radius: 100px; font-size: 0.82rem; font-weight: 700; box-shadow: 0 8px 24px rgba(0,0,0,0.12); }
.over-verhaal .tag { margin-bottom: 14px; }
.over-verhaal h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 18px; }
.over-verhaal p { color: var(--gray-text); line-height: 1.75; margin-bottom: 14px; }
.over-verhaal p strong { color: var(--dark); }
.over-dienst-tags { display: flex; gap: 10px; flex-wrap: wrap; margin: 20px 0; }

.waarden-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.waarde-card { padding: 28px; background: var(--gray-light); border-radius: var(--radius-lg); transition: transform 0.2s; }
.waarde-card:hover { transform: translateY(-3px); }
.wc-icon { width: 52px; height: 52px; border-radius: var(--radius); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; margin-bottom: 14px; }
.waarde-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
.waarde-card p { font-size: 0.85rem; color: var(--gray-text); line-height: 1.65; }

.reviews-grid-over { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.review-over-card { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: var(--radius-lg); padding: 28px; transition: border-color 0.2s; }
.review-over-card:hover { border-color: var(--teal); }
.roc-stars { color: #f0b429; font-size: 1rem; letter-spacing: 2px; margin-bottom: 14px; }
.roc-quote { font-size: 0.9rem; line-height: 1.75; color: rgba(255,255,255,0.75); font-style: italic; margin-bottom: 22px; }
.roc-author { display: flex; align-items: center; gap: 12px; }
.roc-av { width: 42px; height: 42px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.82rem; flex-shrink: 0; }

@media (max-width: 900px) {
  .over-hero-inner { flex-direction: column; align-items: flex-start; }
  .over-hero-stats { flex-direction: row; flex-wrap: wrap; }
  .over-split { grid-template-columns: 1fr; }
  .over-img-wrap { display: none; }
  .waarden-grid { grid-template-columns: 1fr 1fr; }
  .reviews-grid-over { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .waarden-grid { grid-template-columns: 1fr; }
}
</style>
