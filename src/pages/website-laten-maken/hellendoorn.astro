<style>
.loc-hero{background:var(--white);padding:48px 0 72px;border-bottom:3px solid var(--yellow);}
.breadcrumb{display:flex;align-items:center;gap:8px;font-size:0.78rem;color:var(--gray-text);margin-bottom:32px;flex-wrap:wrap;}
.breadcrumb a{color:var(--teal);font-weight:600;}
.breadcrumb span{color:var(--gray-mid);}
.loc-hero-inner{display:grid;grid-template-columns:1fr 300px;gap:48px;align-items:start;}
.loc-hero-text .tag{margin-bottom:16px;}
.loc-hero-text h1{font-size:clamp(2rem,4vw,3.2rem);margin-bottom:18px;}
.loc-intro{font-size:1rem;color:var(--gray-text);line-height:1.75;margin-bottom:24px;font-weight:400;max-width:520px;}
.loc-btns{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:20px;}
.loc-bereik{display:flex;align-items:center;gap:7px;font-size:0.78rem;color:var(--gray-text);}
.loc-bereik svg{color:var(--teal);}
.web-preview-card{background:var(--white);border:1px solid var(--gray-mid);border-radius:var(--radius-lg);overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.08);}
.wpc-bar{background:#f0f0f0;padding:10px 14px;display:flex;align-items:center;gap:10px;}
.wpc-dots{display:flex;gap:5px;}
.wpc-dots span{width:9px;height:9px;border-radius:50%;background:#ddd;}
.wpc-dots span:nth-child(1){background:#ff5f57;}
.wpc-dots span:nth-child(2){background:#febc2e;}
.wpc-dots span:nth-child(3){background:#28c840;}
.wpc-url{flex:1;background:var(--white);border-radius:6px;padding:3px 10px;font-size:0.72rem;color:var(--gray-text);}
.wpc-body{padding:20px;}
.wpc-hero-mock{margin-bottom:16px;}
.wpc-kens{display:flex;gap:8px;flex-wrap:wrap;}
.wpc-kens span{padding:4px 12px;border-radius:100px;font-size:0.72rem;font-weight:700;}
.web-kenmerken{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
.wk-item{background:var(--gray-light);border-radius:var(--radius-lg);padding:24px;transition:transform 0.2s;}
.wk-item:hover{transform:translateY(-3px);}
.wk-icon{width:48px;height:48px;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-size:1.3rem;margin-bottom:14px;}
.wk-item h3{font-size:0.95rem;font-weight:700;margin-bottom:8px;text-transform:none;}
.wk-item p{font-size:0.82rem;color:var(--gray-text);line-height:1.6;font-weight:400;}
.web-pakketten{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
.wp-card{background:var(--white);border-radius:var(--radius-lg);padding:28px;position:relative;}
.wp-featured{border:2px solid rgba(20,18,19,0.15);box-shadow:0 4px 20px rgba(0,0,0,0.08);}
.wp-badge{position:absolute;top:-10px;left:16px;background:var(--dark);color:var(--white);font-size:0.7rem;font-weight:700;padding:3px 12px;border-radius:100px;}
.wp-card h3{font-size:1rem;font-weight:700;margin-bottom:6px;text-transform:none;}
.wp-prijs{font-size:1.4rem;font-weight:800;margin-bottom:4px;}
.wp-prijs small{font-size:0.68rem;font-weight:400;color:var(--gray-text);margin-left:3px;}
.wp-sub{font-size:0.78rem;color:var(--teal);font-weight:600;margin-bottom:16px;}
.wp-card ul{list-style:none;margin-bottom:20px;display:flex;flex-direction:column;gap:8px;}
.wp-card li{font-size:0.84rem;font-weight:500;}
.faq-lijst{display:grid;grid-template-columns:1fr 1fr;gap:20px;}
.faq-item{background:var(--white);border-radius:var(--radius-lg);padding:24px;border-left:4px solid var(--yellow);}
.faq-item h3{font-size:0.92rem;font-weight:700;margin-bottom:8px;text-transform:none;line-height:1.4;}
.faq-item p{font-size:0.84rem;color:var(--gray-text);line-height:1.65;font-weight:400;}
.il-steden{display:flex;gap:10px;flex-wrap:wrap;}
.il-stad{background:rgba(255,255,255,0.08);border:1px solid rgba(255,255,255,0.15);color:rgba(255,255,255,0.7);padding:6px 16px;border-radius:100px;font-size:0.82rem;font-weight:600;transition:background 0.15s,color 0.15s;}
.il-stad:hover,.il-active{background:var(--yellow);color:var(--dark);border-color:var(--yellow);}
@media(max-width:900px){.loc-hero-inner{grid-template-columns:1fr;}.web-preview-card{display:none;}.web-kenmerken{grid-template-columns:1fr 1fr;}.web-pakketten{grid-template-columns:1fr;}.faq-lijst{grid-template-columns:1fr;}}
@media(max-width:600px){.web-kenmerken{grid-template-columns:1fr;}}
</style>
