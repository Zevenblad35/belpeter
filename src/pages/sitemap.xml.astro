---
const pages = [
  { url: 'https://belpeter.nl/', priority: '1.0', changefreq: 'weekly' },
  { url: 'https://belpeter.nl/diensten/', priority: '0.9', changefreq: 'monthly' },
  { url: 'https://belpeter.nl/diensten/fotografie/', priority: '0.9', changefreq: 'monthly' },
  { url: 'https://belpeter.nl/diensten/social-media/', priority: '0.9', changefreq: 'monthly' },
  { url: 'https://belpeter.nl/diensten/websites/', priority: '0.9', changefreq: 'monthly' },
  { url: 'https://belpeter.nl/over/', priority: '0.7', changefreq: 'monthly' },
  { url: 'https://belpeter.nl/blog/', priority: '0.8', changefreq: 'weekly' },
  { url: 'https://belpeter.nl/contact/', priority: '0.8', changefreq: 'monthly' },
];
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {pages.map(page => (
    <url>
      <loc>{page.url}</loc>
      <changefreq>{page.changefreq}</changefreq>
      <priority>{page.priority}</priority>
    </url>
  ))}
</urlset>
