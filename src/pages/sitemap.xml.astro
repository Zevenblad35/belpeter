---
// Disable HTML layout for XML output
export const prerender = true;

const TODAY = new Date().toISOString().split('T')[0];

const pages = [
  // === CORE PAGES — Priority 1.0 ===
  { url: '/', priority: '1.0', changefreq: 'weekly', lastmod: TODAY },
  { url: '/diensten/', priority: '0.95', changefreq: 'monthly', lastmod: TODAY },
  { url: '/contact/', priority: '0.95', changefreq: 'monthly', lastmod: TODAY },

  // === DIENST HOOFDPAGINAS — Priority 0.9 ===
  { url: '/diensten/social-media/', priority: '0.90', changefreq: 'monthly', lastmod: TODAY },
  { url: '/diensten/websites/', priority: '0.90', changefreq: 'monthly', lastmod: TODAY },
  { url: '/diensten/fotografie/', priority: '0.70', changefreq: 'monthly', lastmod: TODAY },

  // === OVER & BLOG ===
  { url: '/over/', priority: '0.80', changefreq: 'monthly', lastmod: TODAY },
  { url: '/blog/', priority: '0.75', changefreq: 'weekly', lastmod: TODAY },

  // === SOCIAL MEDIA LOKAAL — Priority 0.85 ===
  { url: '/social-media/nijverdal/', priority: '0.88', changefreq: 'monthly', lastmod: TODAY },
  { url: '/social-media/hellendoorn/', priority: '0.88', changefreq: 'monthly', lastmod: TODAY },
  { url: '/social-media/wierden/', priority: '0.85', changefreq: 'monthly', lastmod: TODAY },
  { url: '/social-media/rijssen/', priority: '0.83', changefreq: 'monthly', lastmod: TODAY },
  { url: '/social-media/almelo/', priority: '0.83', changefreq: 'monthly', lastmod: TODAY },
  { url: '/social-media/hengelo/', priority: '0.82', changefreq: 'monthly', lastmod: TODAY },
  { url: '/social-media/enschede/', priority: '0.82', changefreq: 'monthly', lastmod: TODAY },
  { url: '/social-media/vriezenveen/', priority: '0.80', changefreq: 'monthly', lastmod: TODAY },

  // === INSTAGRAM BEHEER LOKAAL — Priority 0.80 ===
  { url: '/instagram-beheer/nijverdal/', priority: '0.82', changefreq: 'monthly', lastmod: TODAY },
  { url: '/instagram-beheer/hellendoorn/', priority: '0.82', changefreq: 'monthly', lastmod: TODAY },
  { url: '/instagram-beheer/wierden/', priority: '0.80', changefreq: 'monthly', lastmod: TODAY },
  { url: '/instagram-beheer/almelo/', priority: '0.78', changefreq: 'monthly', lastmod: TODAY },
  { url: '/instagram-beheer/hengelo/', priority: '0.78', changefreq: 'monthly', lastmod: TODAY },
  { url: '/instagram-beheer/enschede/', priority: '0.78', changefreq: 'monthly', lastmod: TODAY },

  // === WEBSITE LATEN MAKEN LOKAAL — Priority 0.82 ===
  { url: '/website-laten-maken/nijverdal/', priority: '0.84', changefreq: 'monthly', lastmod: TODAY },
  { url: '/website-laten-maken/hellendoorn/', priority: '0.84', changefreq: 'monthly', lastmod: TODAY },
  { url: '/website-laten-maken/wierden/', priority: '0.82', changefreq: 'monthly', lastmod: TODAY },
  { url: '/website-laten-maken/rijssen/', priority: '0.80', changefreq: 'monthly', lastmod: TODAY },
  { url: '/website-laten-maken/almelo/', priority: '0.80', changefreq: 'monthly', lastmod: TODAY },
  { url: '/website-laten-maken/hengelo/', priority: '0.78', changefreq: 'monthly', lastmod: TODAY },
  { url: '/website-laten-maken/enschede/', priority: '0.78', changefreq: 'monthly', lastmod: TODAY },
];
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {pages.map(p => (
    <url>
      <loc>https://belpeter.nl{p.url}</loc>
      <lastmod>{p.lastmod}</lastmod>
      <changefreq>{p.changefreq}</changefreq>
      <priority>{p.priority}</priority>
    </url>
  ))}
</urlset>
