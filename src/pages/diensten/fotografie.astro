---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Fotografie Twente — Bedrijfsfotografie via Fotograaf Peter | Bel Peter"
  description="Op zoek naar professionele bedrijfsfotografie in Twente? Peter Rutgers werkt ook als fotograaf voor bedrijven in Nijverdal, Almelo, Hengelo en omgeving."
>

  <section style="background:var(--dark);padding:88px 0;text-align:center;">
    <div class="container">
      <span class="tag tag-white" style="background:rgba(255,255,255,0.1);color:var(--white);margin-bottom:16px;">Fotografie</span>
      <h1 style="color:var(--white);margin-bottom:16px;">BEDRIJFSFOTOGRAFIE<br /><span style="color:var(--yellow)">IN TWENTE</span></h1>
      <p style="color:rgba(255,255,255,0.7);max-width:520px;margin:0 auto 32px;font-size:1rem;line-height:1.75;font-weight:400;">
        Peter is naast zichtbaarheidspartner ook actief als professioneel fotograaf voor bedrijven in Twente. Bedrijfsportretten, productfotografie en sfeerreportages — echte beelden, geen stockfoto's.
      </p>
      <a href="https://fotograafpeter.nl" target="_blank" rel="noopener" class="btn btn-primary">
        Bekijk fotograafpeter.nl
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
    </div>
  </section>

  <section style="background:var(--yellow);padding:80px 0;">
    <div class="container">
      <div class="section-header">
        <span class="tag" style="background:rgba(20,18,19,0.1);color:var(--dark);">Wat biedt Peter?</span>
        <h2 style="color:var(--dark);">VIER SOORTEN<br />FOTOGRAFIE</h2>
        <p style="color:rgba(20,18,19,0.65);">Voor elk type bedrijf het juiste beeld. Op locatie in Twente en Overijssel.</p>
      </div>
      <div class="foto-grid">
        {[
          { icon: '👤', title: 'Zakelijke portretten', desc: 'Voor website, LinkedIn en team. Professioneel en herkenbaar. Mensen kopen van mensen — laat zien wie je bent.' },
          { icon: '🏢', title: 'Sfeer & locatie', desc: 'Jouw werkplek zoals hij écht is. Authentieke beelden die jouw bedrijfscultuur laten zien.' },
          { icon: '📦', title: 'Productfotografie', desc: 'Jouw producten in het beste licht. Klaar voor webshop, brochure of social media.' },
          { icon: '📅', title: 'Events & openingen', desc: 'Jubilea, lanceringen en openingen vastgelegd zoals ze bedoeld zijn.' },
        ].map(f => (
          <div class="fg-card">
            <div class="fg-icon">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="background:var(--dark);padding:80px 0;text-align:center;">
    <div class="container">
      <h2 style="color:var(--white);margin-bottom:16px;">BEKIJK HET VOLLEDIG<br /><span style="color:var(--sky)">PORTFOLIO & DIENSTEN</span></h2>
      <p style="color:rgba(255,255,255,0.6);max-width:460px;margin:0 auto 32px;font-size:0.95rem;line-height:1.7;font-weight:400;">
        Alle informatie over fotografie, prijzen en het portfolio vind je op fotograafpeter.nl.
      </p>
      <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href="https://fotograafpeter.nl" target="_blank" rel="noopener" class="btn btn-primary">
          Naar fotograafpeter.nl
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        </a>
        <a href="/contact" class="btn btn-outline-white">Of neem contact op</a>
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-text">
          <h2>SOCIAL MEDIA OF WEBSITE<br /><span style="color:var(--yellow)">NODIG?</span></h2>
          <p>Naast fotografie helpt Peter je ook met social media beheer en een professionele website.</p>
        </div>
        <div class="cta-actions">
          <a href="/diensten" class="btn btn-primary">Bekijk alle diensten</a>
          <a href="/contact" class="btn btn-outline-white">Kennismaking plannen</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
.foto-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.fg-card { background: var(--white); border-radius: var(--radius-lg); padding: 28px; transition: transform 0.2s; }
.fg-card:hover { transform: translateY(-4px); }
.fg-icon { font-size: 2rem; margin-bottom: 12px; }
.fg-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; text-transform: none; }
.fg-card p { font-size: 0.83rem; color: var(--gray-text); line-height: 1.65; font-weight: 400; }
@media (max-width: 900px) { .foto-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 600px) { .foto-grid { grid-template-columns: 1fr; } }
</style>
