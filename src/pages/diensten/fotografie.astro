---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Bedrijfsfotografie Twente — Peter Rutgers | Bel Peter"
  description="Professionele bedrijfsfotografie in Twente door Peter Rutgers. Bedrijfsportretten, productfotografie en sfeerreportages voor Nijverdal, Almelo, Hengelo en omgeving."
>
  <section class="svc-hero foto-hero">
    <div class="svc-hero-bg">
      <img src="https://fotograafpeter.nl/images/headers/bedrijfsfotografie.jpg" alt="Bedrijfsfotografie Twente" onerror="this.style.display='none'"/>
      <div class="svc-hero-overlay"></div>
    </div>
    <div class="container svc-hero-inner">
      <span class="tag" style="background:rgba(255,240,1,0.2);color:var(--yellow)">Dienst 01 — Fotografie</span>
      <h1>Beelden die laten zien<br /><span style="color:var(--yellow)">wie jij écht bent</span></h1>
      <p>Geen gladde stockfoto's. Wel echte, professionele beelden die jouw verhaal vertellen. Voor websites, LinkedIn, social media en meer.</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:28px;">
        <a href="/contact" class="btn btn-primary">Shoot aanvragen</a>
        <a href="https://fotograafpeter.nl" target="_blank" class="btn btn-outline-white">Bekijk portfolio</a>
      </div>
    </div>
  </section>

  <section style="background:var(--teal);padding:24px 0;">
    <div class="container" style="display:flex;justify-content:center;gap:48px;flex-wrap:wrap;">
      <div style="text-align:center;color:var(--white);">
        <div style="font-family:var(--font-display);font-weight:800;font-size:1.6rem;">Op locatie</div>
        <div style="font-size:0.82rem;opacity:0.8;">In Twente & Overijssel</div>
      </div>
      <div style="text-align:center;color:var(--white);">
        <div style="font-family:var(--font-display);font-weight:800;font-size:1.6rem;">10 werkdagen</div>
        <div style="font-size:0.82rem;opacity:0.8;">Levertijd bewerkte foto's</div>
      </div>
      <div style="text-align:center;color:var(--white);">
        <div style="font-family:var(--font-display);font-weight:800;font-size:1.6rem;">Ruim gebruiksrecht</div>
        <div style="font-size:0.82rem;opacity:0.8;">Web, social & print</div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header">
        <span class="tag">Wat maakt het uit?</span>
        <h2>Mensen kopen van mensen<br />die ze vertrouwen</h2>
        <p>Professionele beelden bouwen dat vertrouwen. Ze laten zien wie jullie zijn, hoe jullie werken en wat jullie bewegen. Dát is wat je website en social media levend maakt.</p>
      </div>
      <div class="foto-types">
        {[
          { img: 'https://fotograafpeter.nl/images/services/bedrijf-portret.jpg', num: '01', title: 'Zakelijke portretten', desc: 'Voor website, LinkedIn en team. Professioneel en herkenbaar.' },
          { img: 'https://fotograafpeter.nl/images/services/bedrijf-sfeer.jpg', num: '02', title: 'Sfeer & locatie', desc: 'Jouw werkplek zoals hij écht is. Authentiek en aansprekend.' },
          { img: 'https://fotograafpeter.nl/images/services/bedrijf-werk.jpg', num: '03', title: 'Aan-het-werk beelden', desc: 'Mensen in beweging, gefocust, in hun element.' },
          { img: 'https://fotograafpeter.nl/images/services/bedrijf-team.jpg', num: '04', title: 'Team & cultuur', desc: 'Groepsfoto\'s die niet stijf aanvoelen — gewoon hoe jullie zijn.' },
          { img: 'https://fotograafpeter.nl/images/services/bedrijf-product.jpg', num: '05', title: 'Productfotografie', desc: 'Jouw product in het beste licht — klaar voor webshop of brochure.' },
          { img: 'https://fotograafpeter.nl/images/services/bedrijf-event.jpg', num: '06', title: 'Events & openingen', desc: 'Jubilea, lanceringen en opening — vastgelegd zoals ze bedoeld zijn.' },
        ].map(item => (
          <div class="foto-type-card">
            <div class="ftc-img">
              <img src={item.img} alt={item.title} onerror="this.parentElement.style.background='var(--forest)';this.style.display='none'"/>
              <span class="ftc-num">{item.num}</span>
            </div>
            <div class="ftc-body">
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="background:var(--yellow);padding:80px 0;">
    <div class="container prijzen-wrap">
      <div class="section-header" style="margin-bottom:48px;">
        <span class="tag tag-yellow" style="background:rgba(0,0,0,0.1);color:var(--dark);">Pakketten</span>
        <h2 style="color:var(--dark);">Transparante prijzen,<br />geen verrassingen</h2>
        <p style="color:rgba(20,18,19,0.7);">Op maat afgestemd op jouw wensen en locatie in Twente.</p>
      </div>
      <div class="prijzen-grid">
        {[
          { name: 'Starter', sub: '2 uur · 20 foto\'s', items: ['Op locatie in Twente','20 bewerkte foto\'s','1 thema of locatie','Online galerij'], featured: false },
          { name: 'Professioneel', sub: '4 uur · 50 foto\'s', items: ['Op locatie in Twente','50 bewerkte foto\'s','2 thema\'s of locaties','Portret + omgeving','Online galerij & download'], featured: true },
          { name: 'Complete shoot', sub: 'Volledige dag', items: ['Volledige dag','100+ bewerkte foto\'s','Meerdere locaties','Team, product & sfeer','Prioriteit in levering'], featured: false },
        ].map(p => (
          <div class={`prijs-card ${p.featured ? 'prijs-featured' : ''}`}>
            {p.featured && <div class="prijs-badge">Meest gekozen</div>}
            <h3>{p.name}</h3>
            <p class="prijs-sub">{p.sub}</p>
            <ul class="prijs-items">
              {p.items.map(i => <li>✓ {i}</li>)}
            </ul>
            <a href="/contact" class={`btn ${p.featured ? 'btn-teal' : 'btn-outline-dark'}`} style="width:100%;justify-content:center;">Aanvragen</a>
          </div>
        ))}
      </div>
      <p style="text-align:center;font-size:0.82rem;color:rgba(20,18,19,0.6);margin-top:20px;">Prijzen op aanvraag · Afhankelijk van wensen en locatie</p>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-text">
          <h2>Klaar voor foto's die<br />écht werken?</h2>
          <p>Plan een vrijblijvende kennismaking met Peter in Twente.</p>
        </div>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">Shoot aanvragen</a>
          <a href="https://fotograafpeter.nl" target="_blank" class="btn btn-outline-white">Bekijk fotograafpeter.nl</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
.svc-hero { position: relative; min-height: 72vh; display: flex; align-items: flex-end; overflow: hidden; }
.svc-hero-bg { position: absolute; inset: 0; }
.svc-hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
.svc-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(20,18,19,0.92) 0%, rgba(20,18,19,0.4) 100%); }
.svc-hero-inner { position: relative; z-index: 2; padding-bottom: 64px; }
.svc-hero-inner h1 { font-size: clamp(2rem, 4.5vw, 3.5rem); font-weight: 800; color: var(--white); margin: 16px 0 16px; letter-spacing: -0.03em; }
.svc-hero-inner p { color: rgba(255,255,255,0.75); max-width: 520px; font-size: 1.05rem; line-height: 1.7; }

.foto-types { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.foto-type-card { border-radius: var(--radius-lg); overflow: hidden; background: var(--gray-light); transition: transform 0.2s; }
.foto-type-card:hover { transform: translateY(-4px); }
.ftc-img { height: 180px; background: var(--dark); position: relative; overflow: hidden; }
.ftc-img img { width: 100%; height: 100%; object-fit: cover; }
.ftc-num { position: absolute; top: 12px; left: 12px; background: var(--teal); color: var(--white); padding: 3px 10px; border-radius: 100px; font-size: 0.72rem; font-weight: 700; }
.ftc-body { padding: 20px; }
.ftc-body h3 { font-size: 1rem; font-weight: 700; margin-bottom: 6px; }
.ftc-body p { font-size: 0.84rem; color: var(--gray-text); line-height: 1.6; }

.prijzen-wrap .section-header { text-align: center; }
.prijzen-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.prijs-card { background: var(--white); border-radius: var(--radius-lg); padding: 32px; position: relative; }
.prijs-featured { background: var(--dark); }
.prijs-badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--teal); color: var(--white); padding: 5px 16px; border-radius: 100px; font-size: 0.75rem; font-weight: 700; white-space: nowrap; }
.prijs-card h3 { font-size: 1.2rem; font-weight: 800; margin-bottom: 4px; }
.prijs-featured h3 { color: var(--white); }
.prijs-sub { font-size: 0.88rem; color: var(--teal); font-weight: 600; margin-bottom: 20px; }
.prijs-items { list-style: none; margin-bottom: 24px; display: flex; flex-direction: column; gap: 10px; }
.prijs-items li { font-size: 0.88rem; }
.prijs-featured .prijs-items li { color: rgba(255,255,255,0.75); }

@media (max-width: 900px) {
  .foto-types, .prijzen-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 600px) {
  .foto-types, .prijzen-grid { grid-template-columns: 1fr; }
}
</style>
