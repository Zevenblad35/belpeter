---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Bedrijfsfotografie Twente — Professionele Foto's | Bel Peter"
  description="Professionele bedrijfsfotografie door Peter Rutgers in Twente. Portretten, productfotografie en sfeerreportages voor ondernemers in Nijverdal, Almelo, Hengelo en omgeving."
  canonical="https://belpeter.nl/diensten/fotografie/"
>

<!-- ─── HERO ───────────────────────────────── -->
<section class="page-hero">
  <div class="container">
    <span class="eyebrow">Dienst — Fotografie</span>
    <h1>Beelden die jouw<br>verhaal vertellen</h1>
    <p>Professionele bedrijfsfotografie voor ondernemers in Twente. Van portretfoto tot sfeerreportage — beelden die je trots op bent en die je klanten aanspreken.</p>
    <div class="hero-ctas">
      <a href="/contact" class="btn btn-primary">Fotoshoot aanvragen</a>
      <a href="https://fotograafpeter.nl" class="btn btn-outline" target="_blank" rel="noopener">Naar fotograafpeter.nl →</a>
    </div>
  </div>
</section>

<!-- ─── WAT PETER MAAKT ────────────────────── -->
<section class="section bg-white">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Wat Peter maakt</span>
      <h2>Fotografie voor<br>elk doel</h2>
    </div>
    <div class="foto-types">
      <div class="foto-type card">
        <div class="foto-emoji" aria-hidden="true">👤</div>
        <h4>Zakelijke portretten</h4>
        <p>Professionele profielfoto's voor LinkedIn, jouw website en marketing materiaal. Persoonlijk en authentiek.</p>
      </div>
      <div class="foto-type card">
        <div class="foto-emoji" aria-hidden="true">🏢</div>
        <h4>Bedrijfsreportage</h4>
        <p>Sfeerbeelden van jouw werkplek, team en processen. Laat zien wie je bent en hoe je werkt.</p>
      </div>
      <div class="foto-type card">
        <div class="foto-emoji" aria-hidden="true">📦</div>
        <h4>Productfotografie</h4>
        <p>Scherpe, aantrekkelijke productfoto's voor jouw webshop, brochure of social media.</p>
      </div>
      <div class="foto-type card">
        <div class="foto-emoji" aria-hidden="true">🎉</div>
        <h4>Evenementenfotografie</h4>
        <p>Openingen, jubilea, bijeenkomsten — Peter legt de sfeer en de mooiste momenten vast.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─── PORTFOLIO ─────────────────────────── -->
<section class="section bg-gray">
  <div class="container">
    <div class="section-header">
      <span class="eyebrow">Portfolio</span>
      <h2>Recente opdrachten<br>in Twente</h2>
    </div>
    <div class="portfolio-masonry">
      <div class="portfolio-card">
        <img src="https://www.peterrutgersmedia.nl/wp-content/uploads/2026/03/Oale_ste_opening-06032026-93.jpg" alt="Evenement fotografie Twente" loading="lazy" />
        <div class="portfolio-label">Evenementenfotografie · Nijverdal</div>
      </div>
      <div class="portfolio-card">
        <img src="https://www.peterrutgersmedia.nl/wp-content/uploads/2026/04/1-819x1024.jpg" alt="Bedrijfsreportage Twente" loading="lazy" />
        <div class="portfolio-label">Bedrijfsreportage · Twente</div>
      </div>
      <div class="portfolio-card">
        <img src="https://www.peterrutgersmedia.nl/wp-content/uploads/2026/02/preventie-bestrijding-beljoost-384x480.png" alt="Social media fotografie" loading="lazy" />
        <div class="portfolio-label">Social Media Content</div>
      </div>
    </div>
    <p style="text-align:center;margin-top:24px">
      <a href="https://fotograafpeter.nl" class="btn btn-outline" target="_blank" rel="noopener">Bekijk volledig portfolio op fotograafpeter.nl →</a>
    </p>
  </div>
</section>

<!-- ─── REDIRECT BANNER ────────────────────── -->
<section class="section bg-yellow">
  <div class="container" style="text-align:center;max-width:620px">
    <span style="font-size:64px;display:block;margin-bottom:20px" aria-hidden="true">📸</span>
    <h2>Meer weten over fotografie?</h2>
    <p style="font-size:17px;margin:14px 0 28px">Peter heeft een speciale website voor zijn fotografiework: <strong>fotograafpeter.nl</strong>. Daar vind je het volledige portfolio, tarieven en meer informatie over een samenwerking.</p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
      <a href="https://fotograafpeter.nl" class="btn btn-dark" target="_blank" rel="noopener">Naar fotograafpeter.nl</a>
      <a href="/contact" class="btn btn-outline">Fotoshoot aanvragen</a>
    </div>
  </div>
</section>

</Layout>

<style>
.page-hero {
  background: var(--yellow); padding: 80px 0 72px; text-align: center;
}
.page-hero h1 { margin: 10px 0 16px; }
.page-hero p  { font-size: 18px; max-width: 560px; margin: 0 auto 28px; }
.hero-ctas { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

.foto-types { display: grid; grid-template-columns: repeat(4,1fr); gap: 20px; }
.foto-emoji { font-size: 36px; margin-bottom: 12px; display: block; }
.foto-type h4 { margin-bottom: 8px; }

.portfolio-masonry { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
.portfolio-card { border-radius: var(--radius-md); overflow: hidden; position: relative; aspect-ratio: 3/4; }
.portfolio-card img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
.portfolio-card:hover img { transform: scale(1.03); }
.portfolio-label {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: linear-gradient(transparent, rgba(0,0,0,.72));
  color: var(--white); font-size: 14px; font-weight: 600; padding: 36px 16px 16px;
}

@media (max-width: 900px) {
  .foto-types { grid-template-columns: repeat(2,1fr); }
  .portfolio-masonry { grid-template-columns: repeat(2,1fr); }
}
@media (max-width: 560px) {
  .foto-types { grid-template-columns: 1fr; }
  .portfolio-masonry { grid-template-columns: 1fr; }
}
</style>
