---
import Layout from '../../layouts/Layout.astro';
---
<Layout
  title="Social Media Beheer Twente — Meer Zichtbaarheid Online | Bel Peter"
  description="Social media strategie en beheer door Peter Rutgers in Twente. Instagram, LinkedIn en Facebook voor ondernemers in Nijverdal, Almelo, Hengelo en omgeving."
>
  <section class="svc-hero" style="background:linear-gradient(135deg, var(--teal) 0%, var(--forest) 100%);">
    <div class="container svc-hero-inner" style="padding:88px 0 64px;">
      <span class="tag" style="background:rgba(255,255,255,0.2);color:var(--white);">Dienst 02 — Social Media</span>
      <h1 style="font-size:clamp(2rem,4.5vw,3.5rem);font-weight:800;color:var(--white);letter-spacing:-0.03em;margin:16px 0 16px;">Van volgers naar<br /><span style="color:var(--yellow)">echte klanten</span></h1>
      <p style="color:rgba(255,255,255,0.8);max-width:520px;font-size:1.05rem;line-height:1.7;margin-bottom:28px;">Een consistente aanwezigheid op social media bouwt vertrouwen. Peter neemt het uit handen — van strategie tot dagelijks beheer.</p>
      <div style="display:flex;gap:14px;flex-wrap:wrap;">
        <a href="/contact" class="btn btn-primary">Start vandaag</a>
        <a href="#aanpak" class="btn btn-outline-white">Bekijk aanpak</a>
      </div>
    </div>
  </section>

  <section style="background:var(--yellow);padding:20px 0;">
    <div class="container" style="display:flex;justify-content:center;gap:48px;flex-wrap:wrap;">
      {['Instagram','LinkedIn','Facebook'].map(p => (
        <div style="text-align:center;">
          <div style="font-family:var(--font-display);font-weight:800;font-size:1.1rem;color:var(--dark);">{p}</div>
          <div style="font-size:0.78rem;color:rgba(20,18,19,0.6);">Actief beheerd</div>
        </div>
      ))}
    </div>
  </section>

  <section id="aanpak">
    <div class="container">
      <div class="section-header">
        <span class="tag">Aanpak</span>
        <h2>Hoe Peter jouw social media<br />laat groeien in Twente</h2>
        <p>Geen standaard templates. Een aanpak die past bij jouw bedrijf en jouw publiek in Twente en omgeving.</p>
      </div>
      <div class="aanpak-stappen">
        {[
          { kleur: 'var(--teal)', icon: '🔍', num: '01', title: 'Strategie & audit', desc: 'Analyse van jouw huidige situatie, doelgroep en concurrenten. Daarna een concreet plan.' },
          { kleur: 'var(--yellow)', icon: '✍️', num: '02', title: 'Contentcreatie', desc: 'Peter maakt content die bij jouw merk past: teksten, visuals en video\'s die engageren.' },
          { kleur: 'var(--sky)', icon: '📤', num: '03', title: 'Publiceren & beheren', desc: 'Alle content op het juiste moment gepubliceerd. Reacties opgepakt, community gebouwd.' },
          { kleur: 'var(--teal)', icon: '📊', num: '04', title: 'Meten & bijsturen', desc: 'Maandelijkse rapportage over bereik, engagement en groei. Continu optimaliseren.' },
        ].map(s => (
          <div class="aanpak-stap">
            <div class="as-num" style={`background:${s.kleur};color:${s.kleur === 'var(--yellow)' ? 'var(--dark)' : 'var(--white)'}`}>{s.num}</div>
            <div class="as-icon">{s.icon}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section style="background:var(--teal-light);">
    <div class="container">
      <div class="section-header">
        <span class="tag">Pakketten</span>
        <h2>Kies wat past<br />bij jouw bedrijf</h2>
      </div>
      <div class="sm-pakket-grid">
        <div class="sm-pakket">
          <h3>Starter</h3>
          <p class="sm-freq">5 posts per maand</p>
          <div class="sm-prijs">€ 199<small>/ maand excl. btw</small></div>
          <ul class="sm-list">
            <li>✓ 1 platform</li>
            <li>✓ Contentplan</li>
            <li>✓ Tekst & visuals</li>
            <li>✓ Publicatie & planning</li>
          </ul>
          <a href="/contact" class="btn btn-outline-dark" style="width:100%;justify-content:center;">Meer info</a>
        </div>
        <div class="sm-pakket sm-featured">
          <div class="sm-badge">Populair</div>
          <h3>Groei</h3>
          <p class="sm-freq">16 posts per maand</p>
          <div class="sm-prijs" style="color:var(--yellow);">€ 349<small style="color:rgba(255,255,255,0.6);">/ maand excl. btw</small></div>
          <ul class="sm-list">
            <li>✓ 2 platformen</li>
            <li>✓ Strategie & contentplan</li>
            <li>✓ Tekst, visuals & Reels</li>
            <li>✓ Community management</li>
            <li>✓ Maandelijkse rapportage</li>
          </ul>
          <a href="/contact" class="btn btn-primary" style="width:100%;justify-content:center;">Meer info</a>
        </div>
        <div class="sm-pakket sm-custom">
          <div style="font-size:2.5rem;margin-bottom:12px;text-align:center;">💬</div>
          <h3 style="text-align:center;">Compleet pakket</h3>
          <p class="sm-freq" style="text-align:center;">Op aanvraag</p>
          <div class="sm-prijs" style="text-align:center;">Op maat</div>
          <p style="font-size:0.84rem;color:var(--gray-text);line-height:1.6;margin-bottom:20px;text-align:center;">Alle platformen, advertentie-beheer en volledige ontzorging.</p>
          <a href="/contact" class="btn btn-outline-dark" style="width:100%;justify-content:center;">Vraag offerte aan</a>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-banner">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-text">
          <h2>Online zichtbaar worden<br />in Twente?</h2>
          <p>Plan een gratis strategiegesprek en ontdek wat social media voor jouw bedrijf kan doen.</p>
        </div>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">Gratis gesprek inplannen</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
.aanpak-stappen { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
.aanpak-stap { background: var(--gray-light); border-radius: var(--radius-lg); padding: 28px; text-align: center; }
.as-num { width: 44px; height: 44px; border-radius: 50%; font-family: var(--font-display); font-weight: 800; font-size: 1rem; display: flex; align-items: center; justify-content: center; margin: 0 auto 10px; }
.as-icon { font-size: 2rem; margin-bottom: 12px; }
.aanpak-stap h3 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
.aanpak-stap p { font-size: 0.84rem; color: var(--gray-text); line-height: 1.6; }
.sm-pakket-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
.sm-prijs { font-family: var(--font); font-weight: 800; font-size: 1.5rem; color: var(--dark); margin-bottom: 16px; }
.sm-prijs small { font-size: 0.7rem; font-weight: 500; color: var(--gray-text); margin-left: 3px; }
.sm-custom { background: var(--gray-light); border: 2px dashed var(--gray-mid) !important; }
.sm-pakket { background: var(--white); border-radius: var(--radius-lg); padding: 32px; border: 2px solid transparent; position: relative; }
.sm-featured { border-color: var(--teal); box-shadow: 0 8px 32px rgba(21,186,179,0.15); }
.sm-badge { position: absolute; top: -12px; left: 50%; transform: translateX(-50%); background: var(--teal); color: var(--white); padding: 5px 16px; border-radius: 100px; font-size: 0.75rem; font-weight: 700; white-space: nowrap; }
.sm-pakket h3 { font-size: 1.2rem; font-weight: 800; margin-bottom: 4px; }
.sm-freq { font-size: 0.88rem; color: var(--teal); font-weight: 600; margin-bottom: 20px; }
.sm-list { list-style: none; margin-bottom: 24px; display: flex; flex-direction: column; gap: 10px; }
.sm-list li { font-size: 0.88rem; }
@media (max-width: 900px) {
  .aanpak-stappen { grid-template-columns: 1fr 1fr; }
  .sm-pakket-grid { grid-template-columns: 1fr; }
}
@media (max-width: 600px) {
  .aanpak-stappen { grid-template-columns: 1fr; }
}
</style>
