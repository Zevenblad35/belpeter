---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Bel Peter — Fotografie, Social Media & Websites | Belpeter.nl">

  <!-- HERO -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-content">
        <span class="tag">Online & offline zichtbaarheid</span>
        <h1>
          Jouw bedrijf<br />
          <span class="hero-accent">zichtbaar</span> gemaakt.
        </h1>
        <p class="hero-sub">
          Van professionele fotografie tot social media en een sterke website.
          Peter zorgt dat jouw bedrijf gezien wordt — door de juiste mensen, op het juiste moment.
        </p>
        <div class="hero-actions">
          <a href="/contact" class="btn btn-primary">
            Gratis kennismaking
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </a>
          <a href="/diensten" class="btn btn-secondary">Bekijk diensten</a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <span class="stat-number">100+</span>
            <span class="stat-label">Tevreden klanten</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">8+</span>
            <span class="stat-label">Jaar ervaring</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-number">3-in-1</span>
            <span class="stat-label">Foto, social & web</span>
          </div>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-card hero-card-main">
          <div class="hero-card-icon">📸</div>
          <h3>Fotografie</h3>
          <p>Professionele beelden die jouw merk neerzetten</p>
        </div>
        <div class="hero-card hero-card-sm hero-card-top">
          <div class="hero-card-icon">📱</div>
          <h3>Social Media</h3>
          <p>Strategie die werkt</p>
        </div>
        <div class="hero-card hero-card-sm hero-card-bottom">
          <div class="hero-card-icon">💻</div>
          <h3>Website</h3>
          <p>Vindbaar & converterend</p>
        </div>
      </div>
    </div>
  </section>

  <!-- VERTROUWEN BAR -->
  <section class="trust-bar">
    <div class="container">
      <p class="trust-label">Vertrouwd door ondernemers in heel Nederland</p>
      <div class="trust-logos">
        <span>Bakker & Zn.</span>
        <span>Studio Linde</span>
        <span>De Groene Keuken</span>
        <span>MT Advies</span>
        <span>Florist Amsterdam</span>
        <span>Tech for SME</span>
      </div>
    </div>
  </section>

  <!-- WAT PETER DOET -->
  <section class="services">
    <div class="container">
      <div class="section-header">
        <span class="tag">Diensten</span>
        <h2>Alles wat je nodig hebt<br />voor meer zichtbaarheid</h2>
        <p>Geen losse stukjes, maar een complete aanpak. Peter combineert fotografie, social media en webdesign tot een coherent verhaal.</p>
      </div>

      <div class="services-grid">
        <a href="/diensten/fotografie" class="service-card service-card-large">
          <div class="service-bg service-bg-foto"></div>
          <div class="service-content">
            <div class="service-icon">📸</div>
            <h3>Fotografie</h3>
            <p>Bedrijfsportretten, productfotografie en reportages die jouw verhaal vertellen. Beelden die je doelgroep raken en onthouden.</p>
            <span class="service-link">
              Meer over fotografie
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>
          </div>
        </a>

        <a href="/diensten/social-media" class="service-card">
          <div class="service-bg service-bg-social"></div>
          <div class="service-content">
            <div class="service-icon">📱</div>
            <h3>Social Media</h3>
            <p>Strategie, contentcreatie en beheer van jouw social media kanalen. Consistente aanwezigheid die volgers omzet in klanten.</p>
            <span class="service-link">
              Meer over social media
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>
          </div>
        </a>

        <a href="/diensten/websites" class="service-card">
          <div class="service-bg service-bg-web"></div>
          <div class="service-content">
            <div class="service-icon">💻</div>
            <h3>Websites</h3>
            <p>Websites die niet alleen mooi zijn, maar ook gevonden worden. SEO-geoptimaliseerd, snel en gebouwd voor conversie.</p>
            <span class="service-link">
              Meer over websites
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- HOE HET WERKT -->
  <section class="how-it-works">
    <div class="container">
      <div class="how-inner">
        <div class="how-text">
          <span class="tag">Werkwijze</span>
          <h2>Van kennismaking tot resultaat</h2>
          <p>Geen gedoe, geen verrassingen. Peter werkt met een helder proces zodat jij weet wat je kunt verwachten.</p>

          <div class="steps">
            <div class="step">
              <div class="step-num">1</div>
              <div class="step-body">
                <h4>Gratis kennismaking</h4>
                <p>We bespreken jouw doelen, uitdagingen en wat je wil bereiken. Geen verplichtingen.</p>
              </div>
            </div>
            <div class="step">
              <div class="step-num">2</div>
              <div class="step-body">
                <h4>Aanpak op maat</h4>
                <p>Peter stelt een plan samen dat past bij jouw bedrijf, budget en tijdlijn.</p>
              </div>
            </div>
            <div class="step">
              <div class="step-num">3</div>
              <div class="step-body">
                <h4>Uitvoering & resultaat</h4>
                <p>Jij doet waar jij goed in bent. Peter zorgt dat jouw bedrijf gezien wordt.</p>
              </div>
            </div>
          </div>

          <a href="/contact" class="btn btn-primary">Plan een kennismaking</a>
        </div>
        <div class="how-visual">
          <div class="how-quote-card">
            <div class="quote-stars">★★★★★</div>
            <p class="quote-text">"Peter heeft onze zichtbaarheid in korte tijd enorm vergroot. De foto's, de website én de social media passen nu perfect bij wie we zijn."</p>
            <div class="quote-author">
              <div class="quote-avatar">JB</div>
              <div>
                <strong>Janneke Bakker</strong>
                <span>Eigenaar Bakker & Zn.</span>
              </div>
            </div>
          </div>
          <div class="how-metric">
            <div class="metric-item">
              <span class="metric-val" style="color: var(--teal)">+340%</span>
              <span class="metric-lbl">Meer websitebezoekers</span>
            </div>
            <div class="metric-item">
              <span class="metric-val" style="color: var(--yellow); filter: brightness(0.8)">+180%</span>
              <span class="metric-lbl">Meer Instagram bereik</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY PETER -->
  <section class="why-peter">
    <div class="container">
      <div class="section-header">
        <span class="tag">Waarom Bel Peter?</span>
        <h2>Één aanspreekpunt,<br />complete zichtbaarheid</h2>
      </div>

      <div class="why-grid">
        <div class="why-item">
          <div class="why-icon">🎯</div>
          <h4>Strategisch denken</h4>
          <p>Geen losse acties, maar een samenhangende aanpak die bijdraagt aan jouw bedrijfsdoelen.</p>
        </div>
        <div class="why-item">
          <div class="why-icon">⚡</div>
          <h4>Snel & persoonlijk</h4>
          <p>Je hebt altijd rechtstreeks contact met Peter. Geen tussenpersonen, geen vertraagde communicatie.</p>
        </div>
        <div class="why-item">
          <div class="why-icon">🔗</div>
          <h4>Alles in samenhang</h4>
          <p>Foto's voor je website, die ook op social media werken. Consistentie in iedere uitingsvorm.</p>
        </div>
        <div class="why-item">
          <div class="why-icon">📈</div>
          <h4>Meetbaar resultaat</h4>
          <p>Peter werkt met duidelijke doelen en rapporteert regelmatig over wat er bereikt wordt.</p>
        </div>
        <div class="why-item">
          <div class="why-icon">🤝</div>
          <h4>Langdurige samenwerking</h4>
          <p>Geen eenmalige transactie, maar een partner die meegroeit met jouw bedrijf.</p>
        </div>
        <div class="why-item">
          <div class="why-icon">💡</div>
          <h4>Eerlijk advies</h4>
          <p>Peter adviseert wat écht werkt voor jouw bedrijf, ook als dat betekent dat je iets anders nodig hebt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="cta-banner">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-text">
          <h2>Klaar om zichtbaarder te worden?</h2>
          <p>Neem contact op voor een gratis kennismaking. Zonder verplichtingen, gewoon een goed gesprek.</p>
        </div>
        <div class="cta-actions">
          <a href="/contact" class="btn btn-primary">Bel Peter nu</a>
          <a href="mailto:peter@belpeter.nl" class="btn btn-secondary">Stuur een mail</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
.hero {
  background: var(--dark);
  color: var(--white);
  padding: 80px 0 100px;
  overflow: hidden;
  position: relative;
}

.hero::before {
  content: '';
  position: absolute;
  top: -200px;
  right: -100px;
  width: 600px;
  height: 600px;
  background: radial-gradient(circle, rgba(21,186,179,0.15) 0%, transparent 70%);
  pointer-events: none;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  align-items: center;
}

.hero-content .tag {
  background: rgba(21,186,179,0.2);
  color: var(--teal);
  margin-bottom: 20px;
  display: inline-block;
}

.hero-content h1 {
  font-size: clamp(2.4rem, 5vw, 3.8rem);
  font-weight: 800;
  color: var(--white);
  margin-bottom: 20px;
  letter-spacing: -0.03em;
}

.hero-accent { color: var(--yellow); }

.hero-sub {
  font-size: 1.1rem;
  color: rgba(255,255,255,0.7);
  max-width: 460px;
  margin-bottom: 32px;
  line-height: 1.7;
}

.hero-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 40px;
}

.hero-stats {
  display: flex;
  align-items: center;
  gap: 24px;
}

.stat { display: flex; flex-direction: column; gap: 2px; }
.stat-number { font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; color: var(--white); }
.stat-label { font-size: 0.78rem; color: rgba(255,255,255,0.5); }
.stat-divider { width: 1px; height: 36px; background: rgba(255,255,255,0.15); }

.hero-visual { position: relative; height: 420px; }

.hero-card {
  position: absolute;
  background: rgba(255,255,255,0.06);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: var(--radius-lg);
  padding: 24px;
  backdrop-filter: blur(12px);
  transition: transform 0.3s ease;
}

.hero-card:hover { transform: translateY(-4px); }
.hero-card-main { bottom: 0; left: 0; right: 160px; }
.hero-card-sm { right: 0; width: 150px; }
.hero-card-top { top: 30px; }
.hero-card-bottom { bottom: 80px; }
.hero-card-icon { font-size: 2rem; margin-bottom: 10px; }
.hero-card h3 { font-size: 1rem; font-weight: 700; color: var(--white); margin-bottom: 4px; }
.hero-card p { font-size: 0.8rem; color: rgba(255,255,255,0.6); line-height: 1.5; }

.trust-bar { background: var(--gray-light); padding: 28px 0; }
.trust-label { font-size: 0.8rem; color: var(--gray-text); text-align: center; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 16px; }
.trust-logos { display: flex; justify-content: center; flex-wrap: wrap; gap: 32px; }
.trust-logos span { font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; color: var(--gray-text); }

.section-header { text-align: center; max-width: 600px; margin: 0 auto 56px; }
.section-header h2 { font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 800; margin: 12px 0 16px; letter-spacing: -0.03em; }
.section-header p { color: var(--gray-text); font-size: 1rem; line-height: 1.7; }

.services-grid { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; gap: 20px; }
.service-card { position: relative; border-radius: var(--radius-lg); overflow: hidden; background: var(--gray-light); transition: transform 0.2s ease, box-shadow 0.2s ease; display: block; }
.service-card:hover { transform: translateY(-4px); box-shadow: 0 20px 48px rgba(0,0,0,0.1); }
.service-card-large { grid-row: 1 / 3; }
.service-bg { height: 200px; }
.service-card-large .service-bg { height: 280px; }
.service-bg-foto { background: linear-gradient(135deg, var(--dark) 0%, var(--forest) 100%); }
.service-bg-social { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%); }
.service-bg-web { background: linear-gradient(135deg, var(--forest) 0%, #1a3a34 100%); }
.service-content { padding: 24px; }
.service-icon { font-size: 1.8rem; margin-bottom: 10px; }
.service-content h3 { font-size: 1.2rem; font-weight: 700; margin-bottom: 8px; color: var(--dark); }
.service-card-large .service-content h3 { font-size: 1.4rem; }
.service-content p { font-size: 0.88rem; color: var(--gray-text); line-height: 1.6; margin-bottom: 16px; }
.service-link { display: inline-flex; align-items: center; gap: 6px; font-size: 0.88rem; font-weight: 600; color: var(--teal); font-family: var(--font-display); }

.how-it-works { background: var(--gray-light); }
.how-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
.how-text h2 { font-size: clamp(1.8rem, 2.5vw, 2.4rem); font-weight: 800; margin: 12px 0 16px; letter-spacing: -0.03em; }
.how-text > p { color: var(--gray-text); margin-bottom: 32px; line-height: 1.7; }
.steps { display: flex; flex-direction: column; gap: 24px; margin-bottom: 32px; }
.step { display: flex; gap: 16px; align-items: flex-start; }
.step-num { width: 36px; height: 36px; border-radius: 50%; background: var(--teal); color: var(--white); font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.step-body h4 { font-size: 1rem; font-weight: 700; margin-bottom: 4px; }
.step-body p { font-size: 0.88rem; color: var(--gray-text); line-height: 1.6; }

.how-quote-card { background: var(--white); border-radius: var(--radius-lg); padding: 28px; box-shadow: 0 8px 32px rgba(0,0,0,0.08); margin-bottom: 16px; }
.quote-stars { color: #f0b429; font-size: 1rem; letter-spacing: 2px; margin-bottom: 14px; }
.quote-text { font-size: 0.95rem; line-height: 1.7; color: var(--dark); font-style: italic; margin-bottom: 20px; }
.quote-author { display: flex; align-items: center; gap: 12px; }
.quote-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--teal); color: var(--white); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.8rem; flex-shrink: 0; }
.quote-author strong { display: block; font-size: 0.9rem; font-weight: 600; }
.quote-author span { font-size: 0.8rem; color: var(--gray-text); }
.how-metric { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.metric-item { background: var(--white); border-radius: var(--radius-lg); padding: 20px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); display: flex; flex-direction: column; gap: 4px; }
.metric-val { font-family: var(--font-display); font-weight: 800; font-size: 1.6rem; }
.metric-lbl { font-size: 0.78rem; color: var(--gray-text); }

.why-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
.why-item { padding: 28px; background: var(--gray-light); border-radius: var(--radius-lg); transition: transform 0.2s; }
.why-item:hover { transform: translateY(-2px); }
.why-icon { font-size: 1.8rem; margin-bottom: 12px; }
.why-item h4 { font-size: 1rem; font-weight: 700; margin-bottom: 8px; }
.why-item p { font-size: 0.88rem; color: var(--gray-text); line-height: 1.6; }

.cta-banner { background: linear-gradient(135deg, var(--forest) 0%, var(--dark) 100%); padding: 72px 0; }
.cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; }
.cta-text h2 { font-size: clamp(1.6rem, 2.5vw, 2.2rem); font-weight: 800; color: var(--white); margin-bottom: 10px; letter-spacing: -0.03em; }
.cta-text p { color: rgba(255,255,255,0.7); font-size: 1rem; }
.cta-actions { display: flex; gap: 12px; flex-shrink: 0; }

@media (max-width: 900px) {
  .hero-inner, .how-inner { grid-template-columns: 1fr; }
  .hero-visual { display: none; }
  .services-grid { grid-template-columns: 1fr; }
  .service-card-large { grid-row: auto; }
  .why-grid { grid-template-columns: 1fr 1fr; }
  .cta-inner { flex-direction: column; text-align: center; }
}

@media (max-width: 600px) {
  .why-grid { grid-template-columns: 1fr; }
  .hero-stats { flex-wrap: wrap; gap: 16px; }
  .hero-actions, .cta-actions { flex-direction: column; }
}
</style>
