---
import Layout from '../layouts/Layout.astro';

const IMG = {
  hero: 'https://www.peterrutgersmedia.nl/wp-content/uploads/2026/03/Oale_ste_opening-06032026-93.jpg',
  peter: 'https://www.peterrutgersmedia.nl/wp-content/uploads/2025/11/peter-metcamera-1024x747.jpg',
  p1: 'https://www.peterrutgersmedia.nl/wp-content/uploads/2026/02/preventie-bestrijding-beljoost-384x480.png',
  p2: 'https://www.peterrutgersmedia.nl/wp-content/uploads/2026/02/het-verhaal-van-384x480.jpg',
  p3: 'https://www.peterrutgersmedia.nl/wp-content/uploads/2026/04/1-819x1024.jpg',
};
---

<Layout title="Bel Peter — Jouw Zichtbaarheidspartner in Twente | Social Media & Websites">

  <!-- ===== HERO ===== -->
  <section class="hero">
    <div class="hero-bg">
      <img src={IMG.hero} alt="Peter Rutgers aan het werk in Twente" loading="eager" />
      <div class="hero-overlay"></div>
    </div>
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="hero-pill">
          <span class="hero-dot"></span>
          Jouw zichtbaarheidspartner in Twente
        </div>
        <h1>ZORG DAT ZE<br /><span class="h-sky">JOU ZIEN.</span></h1>
        <p>
          Peter Rutgers helpt ondernemers in Twente om online meer op te vallen.
          Van een sterke website tot social media die écht werkt.
        </p>
        <div class="hero-btns">
          <a href="/contact" class="btn btn-primary">
            Gratis kennismaking
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </a>
          <a href="/diensten" class="btn btn-outline-white">Bekijk diensten</a>
        </div>
        <p class="hero-loc">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Nijverdal · Almelo · Hengelo · Enschede & heel Twente
        </p>
      </div>
      <div class="hero-cards">
        <div class="hc hc-yellow">
          <span class="hc-val">2+</span>
          <span class="hc-lbl">Jaar ervaring</span>
        </div>
        <div class="hc hc-sky">
          <span class="hc-val">2-in-1</span>
          <span class="hc-lbl">Social · Websites</span>
        </div>
        <div class="hc">
          <span class="hc-val">Twente</span>
          <span class="hc-lbl">Jouw regio</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== DIENSTEN ===== -->
  <section class="diensten">
    <div class="container">
      <div class="diensten-header">
        <span class="tag">Wat Peter doet</span>
        <h2>TWEE DIENSTEN,<br />ÉÉN DOEL: <span style="color:var(--sky)">GEZIEN WORDEN</span></h2>
        <p>Peter combineert website- en social media expertise tot een samenhangende aanpak die jouw bedrijf zichtbaar maakt in Twente.</p>
      </div>

      <div class="diensten-grid">
        <a href="/diensten/social-media" class="dcard">
          <div class="dcard-img dcard-social">
            <img src={IMG.p1} alt="Social media content Twente" />
            <div class="dcard-img-overlay"></div>
            <span class="dcard-nr">01</span>
          </div>
          <div class="dcard-body">
            <div class="dcard-tag" style="background:rgba(255,240,1,0.15);color:#7a6a00;">Social Media</div>
            <h3>SOCIAL MEDIA</h3>
            <p>Van strategie tot dagelijks beheer. Peter zorgt voor consistente, professionele aanwezigheid op Instagram, LinkedIn en Facebook.</p>
            <ul class="dcard-ul">
              <li>Contentplan & strategie</li>
              <li>Tekst, visuals & Reels</li>
              <li>Community management</li>
              <li>Maandelijkse rapportage</li>
            </ul>
            <span class="dcard-cta">Meer over social media →</span>
          </div>
        </a>

        <a href="/diensten/websites" class="dcard">
          <div class="dcard-img dcard-web">
            <img src={IMG.p2} alt="Website Twente" />
            <div class="dcard-img-overlay"></div>
            <span class="dcard-nr">02</span>
          </div>
          <div class="dcard-body">
            <div class="dcard-tag" style="background:var(--sky-light);color:#0369a1;">Websites</div>
            <h3>WEBSITES</h3>
            <p>Vindbaar, snel en converterend. Een website die niet alleen mooi is, maar ook gevonden wordt door jouw klanten in Twente.</p>
            <ul class="dcard-ul">
              <li>Op maat ontwerp</li>
              <li>SEO-geoptimaliseerd</li>
              <li>Mobielvriendelijk</li>
              <li>CMS voor eigen beheer</li>
            </ul>
            <span class="dcard-cta">Meer over websites →</span>
          </div>
        </a>
      </div>

      <!-- Fotografie referral card -->
      <a href="/diensten/fotografie" class="foto-referral">
        <div class="foto-referral-inner">
          <div class="foto-ref-icon">📸</div>
          <div>
            <strong>Op zoek naar fotografie?</strong>
            <p>Peter is ook actief als professioneel fotograaf voor bedrijven in Twente via fotograafpeter.nl — bekijk de mogelijkheden.</p>
          </div>
          <span class="foto-ref-link">Meer info →</span>
        </div>
      </a>
    </div>
  </section>

  <!-- ===== OVER PETER ===== -->
  <section class="over-peter">
    <div class="container over-peter-inner">
      <div class="op-foto">
        <div class="op-foto-frame">
          <img src={IMG.peter} alt="Peter Rutgers — Bel Peter Nijverdal" />
        </div>
        <div class="op-badge">📍 Nijverdal, Twente</div>
      </div>
      <div class="op-tekst">
        <span class="tag tag-yellow">Wie is Peter?</span>
        <h2>JOUW ZICHTBAARHEID<br />IS MIJN VAK</h2>
        <p>Ik ben <strong>Peter Rutgers</strong> uit Nijverdal. Ik help ondernemers en bedrijven in Twente om op te vallen — online én offline. Met een sterke website en actieve social media zorg ik dat jouw bedrijf gezien wordt door de juiste mensen.</p>
        <p>Als lokale partner ken ik Twente. Ik weet hoe ondernemers hier werken en wat hun klanten zoeken.</p>
        <div class="op-stats">
          <div class="op-stat" style="border-left:4px solid var(--yellow)">
            <strong>Social Media</strong>
            <span>Instagram, LinkedIn & Facebook</span>
          </div>
          <div class="op-stat" style="border-left:4px solid var(--sky)">
            <strong>Websites</strong>
            <span>SEO-proof & converterend</span>
          </div>
        </div>
        <a href="/over" class="btn btn-dark">Lees Peter's verhaal</a>
      </div>
    </div>
  </section>

  <!-- ===== WERKWIJZE ===== -->
  <section class="werkwijze">
    <div class="container">
      <div class="section-header" style="text-align:left;max-width:none;margin-bottom:0;">
        <span class="tag">Werkwijze</span>
        <h2 style="margin-top:12px;">VAN GESPREK TOT<br />ZICHTBAAR RESULTAAT</h2>
      </div>
      <div class="stappen-wrap">
        <div class="stap">
          <div class="stap-icon" style="background:var(--yellow);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--dark)" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3>Gratis kennismaking</h3>
          <p>We bespreken jouw bedrijf, doelen en uitdagingen. Geen verplichtingen.</p>
        </div>
        <div class="stap-pijl">→</div>
        <div class="stap">
          <div class="stap-icon" style="background:var(--sky);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--dark)" stroke-width="2.2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <h3>Aanpak op maat</h3>
          <p>Peter stelt een plan samen passend bij jouw bedrijf en budget in Twente.</p>
        </div>
        <div class="stap-pijl">→</div>
        <div class="stap">
          <div class="stap-icon" style="background:var(--teal);">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
          </div>
          <h3>Zichtbaar resultaat</h3>
          <p>Jij focust op je vak. Peter zorgt dat jouw bedrijf gezien wordt.</p>
        </div>
      </div>
      <div style="text-align:center;margin-top:40px;">
        <a href="/contact" class="btn btn-primary">Start met een kennismaking</a>
      </div>
    </div>
  </section>

  <!-- ===== PORTFOLIO ===== -->
  <section class="portfolio" style="background:var(--dark);padding:88px 0;">
    <div class="container">
      <div class="section-header">
        <span class="tag tag-white">Portfolio</span>
        <h2 style="color:var(--white);">RESULTATEN UIT<br /><span style="color:var(--yellow)">DE PRAKTIJK</span></h2>
        <p style="color:rgba(255,255,255,0.6);">Voorbeelden van social media content en websites voor Twentse ondernemers.</p>
      </div>
      <div class="portfolio-grid">
        <div class="pgrid-item pgrid-tall">
          <img src={IMG.p1} alt="Social media content — Beljoost" />
          <div class="pgrid-label">Social Media Content</div>
        </div>
        <div class="pgrid-item">
          <img src={IMG.p2} alt="Content productie Twente" />
          <div class="pgrid-label">Content Productie</div>
        </div>
        <div class="pgrid-item">
          <img src={IMG.p3} alt="Zichtbaarheid project Twente" />
          <div class="pgrid-label">Zichtbaarheidsproject</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== REVIEWS ===== -->
  <section class="reviews" style="background:var(--gray-light);">
    <div class="container">
      <div class="section-header">
        <span class="tag">Klanten aan het woord</span>
        <h2>WAT TWENTSE ONDERNEMERS<br />OVER PETER ZEGGEN</h2>
      </div>
      <div class="reviews-grid">
        <div class="review-card">
          <div class="rv-stars">★★★★★</div>
          <p>"Peter heeft onze social media volledig opgezet. We krijgen nu echt reacties van potentiële klanten — iets wat voorheen nooit lukte."</p>
          <div class="rv-author">
            <div class="rv-av" style="background:var(--teal);">JB</div>
            <div><strong>Janneke Bakker</strong><span>Bakker & Zn. · Nijverdal</span></div>
          </div>
        </div>
        <div class="review-card review-featured">
          <div class="rv-stars">★★★★★</div>
          <p>"Eindelijk een website die gevonden wordt. Peter heeft alles goed uitgelegd en is altijd snel te bereiken. Absolute aanrader!"</p>
          <div class="rv-author">
            <div class="rv-av" style="background:var(--yellow);color:var(--dark);">TM</div>
            <div><strong style="color:var(--white);">Thomas Meijer</strong><span style="color:rgba(255,255,255,0.6);">MT Advies · Almelo</span></div>
          </div>
        </div>
        <div class="review-card">
          <div class="rv-stars">★★★★★</div>
          <p>"Persoonlijk contact, eerlijk advies en écht resultaat. Peter denkt met je mee en levert kwaliteit. We werken al een jaar samen."</p>
          <div class="rv-author">
            <div class="rv-av" style="background:var(--sky);color:var(--dark);">LV</div>
            <div><strong>Lisa van Dijk</strong><span>Studio Linde · Hengelo</span></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section class="cta-banner">
    <div class="container">
      <div class="cta-inner">
        <div class="cta-text">
          <h2>KLAAR OM ZICHTBAARDER<br /><span style="color:var(--yellow)">TE WORDEN IN TWENTE?</span></h2>
          <p>Bel Peter of plan een gratis kennismaking. Vrijblijvend, gewoon een goed gesprek.</p>
        </div>
        <div class="cta-actions">
          <a href="tel:+31851155136" class="btn btn-primary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.73 16"/></svg>
            085 115 5136
          </a>
          <a href="/contact" class="btn btn-outline-white">Plan kennismaking</a>
        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ===== HERO ===== */
.hero {
  position: relative;
  min-height: 94vh;
  display: flex;
  align-items: center;
  overflow: hidden;
  background: var(--dark);
}

.hero-bg { position: absolute; inset: 0; }
.hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
.hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(110deg, rgba(20,18,19,0.90) 0%, rgba(20,18,19,0.55) 60%, rgba(20,18,19,0.15) 100%);
}

.hero-inner {
  position: relative; z-index: 2;
  display: flex; align-items: flex-end; justify-content: space-between;
  gap: 40px; padding-top: 56px; padding-bottom: 56px;
}

.hero-pill {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
  color: var(--white); padding: 7px 16px; border-radius: 100px;
  font-size: 0.78rem; font-weight: 600; letter-spacing: 0.02em; margin-bottom: 18px;
  backdrop-filter: blur(8px);
}

.hero-dot {
  width: 8px; height: 8px; border-radius: 50%; background: var(--teal);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.75); }
}

.hero-content h1 {
  font-size: clamp(3rem, 7.5vw, 6rem);
  color: var(--white); margin-bottom: 20px; line-height: 1;
}

.h-sky { color: var(--sky); display: block; }

.hero-content > p {
  font-size: 1.1rem; color: rgba(255,255,255,0.75);
  max-width: 440px; line-height: 1.7; margin-bottom: 28px; font-weight: 400;
}

.hero-btns { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; }

.hero-loc {
  display: flex; align-items: center; gap: 7px;
  font-size: 0.78rem; color: rgba(255,255,255,0.45); font-weight: 400;
}
.hero-loc svg { color: var(--teal); flex-shrink: 0; }

.hero-cards { display: flex; flex-direction: column; gap: 12px; flex-shrink: 0; }

.hc {
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.12);
  backdrop-filter: blur(16px);
  border-radius: var(--radius-lg);
  padding: 18px 26px; min-width: 155px;
  display: flex; flex-direction: column; gap: 3px;
}

.hc-yellow { background: rgba(255,240,1,0.12); border-color: rgba(255,240,1,0.3); }
.hc-sky { background: rgba(125,211,252,0.1); border-color: rgba(125,211,252,0.25); }

.hc-val {
  font-weight: 900; font-size: 1.7rem; color: var(--white);
  letter-spacing: -0.03em; line-height: 1;
}
.hc-yellow .hc-val { color: var(--yellow); }
.hc-sky .hc-val { color: var(--sky); }

.hc-lbl { font-size: 0.72rem; color: rgba(255,255,255,0.45); font-weight: 500; }

/* ===== DIENSTEN ===== */
.diensten { background: var(--yellow); padding: 0; }

.diensten-header {
  background: var(--yellow);
  padding: 72px 0 56px;
  text-align: center;
}

.diensten-header .tag { background: rgba(20,18,19,0.12); color: var(--dark); margin-bottom: 14px; }
.diensten-header h2 { color: var(--dark); margin-bottom: 14px; }
.diensten-header p { color: rgba(20,18,19,0.65); max-width: 560px; margin: 0 auto; font-size: 0.95rem; line-height: 1.7; font-weight: 400; }

.diensten-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; padding-bottom: 28px; }

.dcard {
  background: var(--white); border-radius: var(--radius-lg);
  overflow: hidden; display: block; color: var(--dark);
  transition: transform 0.25s, box-shadow 0.25s;
}
.dcard:hover { transform: translateY(-6px); box-shadow: 0 24px 56px rgba(0,0,0,0.18); }

.dcard-img { position: relative; height: 260px; overflow: hidden; background: var(--dark); }
.dcard-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
.dcard:hover .dcard-img img { transform: scale(1.04); }
.dcard-img-overlay { position: absolute; inset: 0; background: rgba(20,18,19,0.35); }
.dcard-social .dcard-img-overlay { background: rgba(20,18,19,0.2); }
.dcard-web .dcard-img-overlay { background: rgba(125,211,252,0.2); }

.dcard-nr {
  position: absolute; top: 14px; left: 14px;
  background: rgba(255,255,255,0.15); backdrop-filter: blur(8px);
  color: var(--white); padding: 3px 10px; border-radius: 100px;
  font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em;
}

.dcard-body { padding: 26px; }
.dcard-tag { display: inline-block; padding: 4px 12px; border-radius: 100px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 10px; }
.dcard-body h3 { font-size: 1.2rem; margin-bottom: 10px; }
.dcard-body p { font-size: 0.86rem; color: var(--gray-text); line-height: 1.65; margin-bottom: 14px; font-weight: 400; }
.dcard-ul { list-style: none; margin-bottom: 18px; display: flex; flex-direction: column; gap: 7px; }
.dcard-ul li { font-size: 0.82rem; color: var(--dark); font-weight: 500; }
.dcard-ul li::before { content: '✓ '; color: var(--teal); font-weight: 700; }
.dcard-cta { font-size: 0.82rem; font-weight: 700; color: var(--teal); text-transform: uppercase; letter-spacing: 0.04em; }

.foto-referral {
  display: block;
  background: rgba(20,18,19,0.06);
  border: 2px dashed rgba(20,18,19,0.2);
  border-radius: var(--radius-lg);
  margin-bottom: 0;
  color: var(--dark);
  transition: background 0.15s, border-color 0.15s;
}
.foto-referral:hover { background: rgba(20,18,19,0.1); border-color: rgba(20,18,19,0.35); }
.foto-referral-inner { display: flex; align-items: center; gap: 18px; padding: 20px 24px; }
.foto-ref-icon { font-size: 1.8rem; flex-shrink: 0; }
.foto-referral-inner strong { display: block; font-weight: 700; font-size: 0.9rem; margin-bottom: 3px; }
.foto-referral-inner p { font-size: 0.82rem; color: rgba(20,18,19,0.6); font-weight: 400; margin: 0; }
.foto-ref-link { margin-left: auto; font-size: 0.82rem; font-weight: 700; color: var(--teal); flex-shrink: 0; text-transform: uppercase; letter-spacing: 0.04em; }

/* ===== OVER PETER ===== */
.over-peter { background: var(--off-white, #fffef8); }

.over-peter-inner {
  display: grid; grid-template-columns: 1fr 1.5fr; gap: 64px; align-items: center;
}

.op-foto { position: relative; }
.op-foto-frame {
  border-radius: var(--radius-lg); overflow: hidden;
  border: 5px solid var(--yellow);
  aspect-ratio: 4/3;
}
.op-foto-frame img { width: 100%; height: 100%; object-fit: cover; object-position: center top; }
.op-badge {
  position: absolute; bottom: -16px; right: -16px;
  background: var(--sky); color: var(--dark);
  padding: 10px 18px; border-radius: 100px;
  font-size: 0.8rem; font-weight: 700;
  box-shadow: 0 8px 24px rgba(0,0,0,0.1);
}

.op-tekst .tag { margin-bottom: 14px; }
.op-tekst h2 { margin-bottom: 18px; }
.op-tekst p { color: var(--gray-text); line-height: 1.75; margin-bottom: 14px; font-weight: 400; }
.op-tekst p strong { color: var(--dark); font-weight: 700; }

.op-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 20px 0 28px; }
.op-stat { padding: 14px 16px; background: var(--white); border-radius: var(--radius); }
.op-stat strong { display: block; font-size: 0.88rem; font-weight: 700; margin-bottom: 3px; }
.op-stat span { font-size: 0.75rem; color: var(--gray-text); font-weight: 400; }

/* ===== WERKWIJZE ===== */
.werkwijze { background: var(--dark); padding: 88px 0; }
.werkwijze .section-header h2 { color: var(--white); }

.stappen-wrap {
  display: flex; align-items: flex-start; gap: 0;
  margin: 56px 0 0;
}

.stap { flex: 1; text-align: center; padding: 0 28px; }
.stap-icon {
  width: 68px; height: 68px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 18px;
}
.stap h3 { color: var(--white); font-size: 1.05rem; margin-bottom: 8px; text-transform: none; }
.stap p { font-size: 0.84rem; color: rgba(255,255,255,0.5); line-height: 1.65; font-weight: 400; }
.stap-pijl { font-size: 1.8rem; color: rgba(255,255,255,0.15); padding-top: 24px; flex-shrink: 0; font-weight: 300; }

/* ===== PORTFOLIO ===== */
.portfolio-grid {
  display: grid; grid-template-columns: 1.2fr 1fr; grid-template-rows: 280px 280px; gap: 16px;
}
.pgrid-item { border-radius: var(--radius-lg); overflow: hidden; background: var(--dark); position: relative; }
.pgrid-tall { grid-row: 1 / 3; }
.pgrid-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }
