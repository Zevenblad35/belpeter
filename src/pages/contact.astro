---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Kennismaking Plannen — Bel Peter | Gratis Gesprek"
  description="Plan een gratis kennismakingsgesprek met Peter. Fotografie, social media of website in Twente. Kies jouw voorkeur en we nemen contact op."
>

  <!-- HERO -->
  <section style="background:var(--yellow);padding:72px 0 60px;text-align:center;">
    <div class="container">
      <span class="tag" style="background:rgba(20,18,19,0.1);color:var(--dark);margin-bottom:16px;display:inline-block;">Contact</span>
      <h1 style="letter-spacing:-0.03em;margin-bottom:16px;font-size:clamp(2rem,4vw,3rem);">LATEN WE<br />KENNISMAKEN</h1>
      <p style="color:rgba(20,18,19,0.65);max-width:460px;margin:0 auto;font-size:1rem;line-height:1.7;font-weight:400;">Vul het formulier in en Peter neemt contact met je op om een afspraak te plannen. Gratis en vrijblijvend.</p>
    </div>
  </section>

  <section style="background:var(--dark);padding:14px 0;">
    <div class="container" style="display:flex;justify-content:center;align-items:center;gap:32px;flex-wrap:wrap;">
      <a href="tel:+31851155136" style="display:flex;align-items:center;gap:8px;color:var(--yellow);font-weight:700;font-size:0.85rem;text-transform:uppercase;letter-spacing:0.04em;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.73 16"/></svg>
        085 115 5136
      </a>
      <span style="color:rgba(255,255,255,0.2);">|</span>
      <a href="mailto:peter@belpeter.nl" style="color:var(--teal);font-weight:600;font-size:0.85rem;">peter@belpeter.nl</a>
      <span style="color:rgba(255,255,255,0.2);">|</span>
      <span style="color:rgba(255,255,255,0.45);font-size:0.82rem;">📍 Nijverdal, Twente</span>
    </div>
  </section>

  <!-- MULTI-STEP FORM -->
  <section style="background:var(--gray-light);padding:80px 0;">
    <div class="container">
      <div class="form-wrap">

        <!-- Progress bar -->
        <div class="progress-bar">
          <div class="progress-steps">
            <div class="ps-step active" data-step="1">
              <div class="ps-dot">1</div>
              <span>Onderwerp</span>
            </div>
            <div class="ps-line"></div>
            <div class="ps-step" data-step="2">
              <div class="ps-dot">2</div>
              <span>Details</span>
            </div>
            <div class="ps-line"></div>
            <div class="ps-step" data-step="3">
              <div class="ps-dot">3</div>
              <span>Voorkeur</span>
            </div>
            <div class="ps-line"></div>
            <div class="ps-step" data-step="4">
              <div class="ps-dot">4</div>
              <span>Contact</span>
            </div>
          </div>
        </div>

        <!-- STEP 1: Onderwerp -->
        <div class="form-step active" id="step-1">
          <div class="step-header">
            <span class="step-num">Stap 1 van 4</span>
            <h2>Waarvoor wil je<br />kennismaken?</h2>
            <p>Selecteer het onderwerp van jouw kennismakingsgesprek met Peter.</p>
          </div>
          <div class="dienst-keuze">
            <label class="dienst-opt">
              <input type="radio" name="dienst" value="fotografie"/>
              <div class="dienst-card">
                <span class="dienst-icon" style="background:var(--teal-light);color:var(--teal);">📸</span>
                <h3>Fotografie</h3>
                <p>Bedrijfsfotografie, portretten of productfotografie in Twente</p>
              </div>
            </label>
            <label class="dienst-opt">
              <input type="radio" name="dienst" value="social-media"/>
              <div class="dienst-card">
                <span class="dienst-icon" style="background:rgba(255,240,1,0.2);color:#7a6a00;">📱</span>
                <h3>Social Media</h3>
                <p>Strategie, contentcreatie of beheer van jouw social kanalen</p>
              </div>
            </label>
            <label class="dienst-opt">
              <input type="radio" name="dienst" value="website"/>
              <div class="dienst-card">
                <span class="dienst-icon" style="background:var(--sky-light);color:#0369a1;">💻</span>
                <h3>Website</h3>
                <p>Nieuwe website of verbetering van jouw huidige website</p>
              </div>
            </label>
            <label class="dienst-opt">
              <input type="radio" name="dienst" value="alles"/>
              <div class="dienst-card">
                <span class="dienst-icon" style="background:rgba(20,18,19,0.06);color:var(--dark);">🚀</span>
                <h3>Alles / combinatie</h3>
                <p>Ik wil mijn volledige online zichtbaarheid verbeteren</p>
              </div>
            </label>
          </div>
          <div class="step-nav">
            <button class="btn btn-dark next-btn" data-next="2" disabled>
              Volgende stap
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
          </div>
        </div>

        <!-- STEP 2: Details -->
        <div class="form-step" id="step-2">
          <div class="step-header">
            <span class="step-num">Stap 2 van 4</span>
            <h2>Vertel iets over<br />jouw bedrijf</h2>
            <p>Zodat Peter goed voorbereid het gesprek in kan gaan.</p>
          </div>
          <div class="form-fields">
            <div class="field-group">
              <label>Bedrijfsnaam *</label>
              <input type="text" id="bedrijfsnaam" placeholder="Jouw bedrijfsnaam" required/>
            </div>
            <div class="field-group">
              <label>Branche *</label>
              <input type="text" id="branche" placeholder="Bijv. bouw, horeca, zorg, retail..."/>
            </div>
            <div class="field-group field-full">
              <label>Wat heb je al aan zichtbaarheid? *</label>
              <textarea id="zichtbaarheid" rows="4" placeholder="Bijv. ik heb al een website, maar geen social media. Of: ik begin helemaal opnieuw. Wat werkt goed, wat niet?"></textarea>
            </div>
          </div>
          <div class="step-nav">
            <button class="btn btn-outline-dark prev-btn" data-prev="1">← Terug</button>
            <button class="btn btn-dark next-btn" data-next="3">
              Volgende stap
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
          </div>
        </div>

        <!-- STEP 3: Voorkeur dag & contactwijze -->
        <div class="form-step" id="step-3">
          <div class="step-header">
            <span class="step-num">Stap 3 van 4</span>
            <h2>Wanneer en hoe<br />stel jij het voor?</h2>
            <p>Peter is beschikbaar van dinsdag t/m vrijdag overdag.</p>
          </div>

          <div class="voorkeur-section">
            <label class="voorkeur-label">Voorkeursdag(en) — meerdere mogelijk</label>
            <div class="dag-keuze">
              {['Dinsdag', 'Woensdag', 'Donderdag', 'Vrijdag'].map(dag => (
                <label class="dag-opt">
                  <input type="checkbox" name="dag" value={dag.toLowerCase()}/>
                  <span class="dag-card">{dag}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="voorkeur-section">
            <label class="voorkeur-label">Voorkeur voor contact *</label>
            <div class="contact-keuze">
              <label class="contact-opt">
                <input type="radio" name="contactwijze" value="telefoon"/>
                <div class="contact-card">
                  <span>📞</span>
                  <strong>Telefoon</strong>
                  <p>Gewoon even bellen</p>
                </div>
              </label>
              <label class="contact-opt">
                <input type="radio" name="contactwijze" value="beeldbellen"/>
                <div class="contact-card">
                  <span>💻</span>
                  <strong>Beeldbellen</strong>
                  <p>Via Teams of Zoom</p>
                </div>
              </label>
              <label class="contact-opt">
                <input type="radio" name="contactwijze" value="face2face"/>
                <div class="contact-card">
                  <span>🤝</span>
                  <strong>Face to face</strong>
                  <p>Bij jou of in Nijverdal</p>
                </div>
              </label>
            </div>
          </div>

          <div class="step-nav">
            <button class="btn btn-outline-dark prev-btn" data-prev="2">← Terug</button>
            <button class="btn btn-dark next-btn" data-next="4">
              Volgende stap
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            </button>
          </div>
        </div>

        <!-- STEP 4: Contactgegevens -->
        <div class="form-step" id="step-4">
          <div class="step-header">
            <span class="step-num">Stap 4 van 4</span>
            <h2>Jouw contactgegevens</h2>
            <p>Zodat Peter je kan bereiken om de afspraak te bevestigen.</p>
          </div>
          <div class="form-fields">
            <div class="field-group">
              <label>Naam *</label>
              <input type="text" id="naam" placeholder="Jouw naam" required/>
            </div>
            <div class="field-group">
              <label>Telefoonnummer *</label>
              <input type="tel" id="telefoon" placeholder="06 00 000 000" required/>
            </div>
            <div class="field-group field-full">
              <label>E-mailadres *</label>
              <input type="email" id="email" placeholder="jouw@email.nl" required/>
            </div>
            <div class="field-group field-full">
              <label>Aanvullende opmerkingen</label>
              <textarea id="opmerking" rows="3" placeholder="Is er nog iets wat Peter vooraf moet weten?"></textarea>
            </div>
          </div>

          <div class="step-summary" id="step-summary">
            <!-- Filled by JS -->
          </div>

          <div class="step-nav">
            <button class="btn btn-outline-dark prev-btn" data-prev="3">← Terug</button>
            <button class="btn btn-primary submit-btn" id="submit-btn">
              Verstuur aanvraag ✓
            </button>
          </div>
        </div>

        <!-- SUCCESS -->
        <div class="form-step" id="step-success">
          <div class="success-wrap">
            <div class="success-icon">🎉</div>
            <h2>Aanvraag ontvangen!</h2>
            <p>Bedankt voor je aanvraag. Peter neemt zo snel mogelijk contact met je op om de kennismaking in te plannen.</p>
            <div class="success-details">
              <p>💌 Je ontvangt een bevestiging op jouw e-mailadres.</p>
              <p>⏱️ Peter reageert doorgaans binnen 1 werkdag.</p>
            </div>
            <a href="/" class="btn btn-dark" style="margin-top:24px;">Terug naar home</a>
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>

<style>
.form-wrap {
  max-width: 780px;
  margin: 0 auto;
  background: var(--white);
  border-radius: var(--radius-lg);
  box-shadow: 0 8px 48px rgba(0,0,0,0.08);
  overflow: hidden;
}

/* PROGRESS BAR */
.progress-bar {
  background: var(--dark);
  padding: 24px 40px;
}

.progress-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0;
}

.ps-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}

.ps-dot {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.85rem;
  transition: background 0.3s, color 0.3s;
}

.ps-step span {
  font-size: 0.7rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: rgba(255,255,255,0.35);
  transition: color 0.3s;
}

.ps-step.active .ps-dot { background: var(--yellow); color: var(--dark); }
.ps-step.active span { color: var(--yellow); }
.ps-step.done .ps-dot { background: var(--teal); color: var(--white); }
.ps-step.done span { color: var(--teal); }

.ps-line {
  flex: 1;
  height: 2px;
  background: rgba(255,255,255,0.1);
  margin: 0 8px;
  margin-bottom: 22px;
  min-width: 40px;
  transition: background 0.3s;
}

.ps-line.done { background: var(--teal); }

/* STEP PANELS */
.form-step {
  display: none;
  padding: 48px 48px 40px;
}

.form-step.active { display: block; }

.step-header { margin-bottom: 36px; }
.step-num { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--teal); display: block; margin-bottom: 10px; }
.step-header h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 10px; }
.step-header p { color: var(--gray-text); font-size: 0.92rem; font-weight: 400; }

/* DIENST KEUZE */
.dienst-keuze {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin-bottom: 36px;
}

.dienst-opt input { position: absolute; opacity: 0; pointer-events: none; }

.dienst-card {
  border: 2px solid var(--gray-mid);
  border-radius: var(--radius-lg);
  padding: 20px;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.dienst-opt:hover .dienst-card { border-color: var(--teal); }
.dienst-opt input:checked + .dienst-card {
  border-color: var(--yellow);
  background: rgba(255,240,1,0.07);
}

.dienst-icon {
  width: 44px;
  height: 44px;
  border-radius: var(--radius);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
}

.dienst-card h3 { font-size: 1rem; font-weight: 700; text-transform: none; }
.dienst-card p { font-size: 0.8rem; color: var(--gray-text); font-weight: 400; line-height: 1.5; text-transform: none; }

/* FORM FIELDS */
.form-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-bottom: 32px;
}

.field-group { display: flex; flex-direction: column; gap: 7px; }
.field-full { grid-column: 1 / -1; }

.field-group label {
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--dark);
}

.field-group input,
.field-group textarea,
.field-group select {
  padding: 12px 16px;
  border: 2px solid var(--gray-mid);
  border-radius: var(--radius);
  font-size: 0.9rem;
  font-family: var(--font);
  color: var(--dark);
  background: var(--white);
  transition: border-color 0.15s;
  outline: none;
}

.field-group input:focus,
.field-group textarea:focus { border-color: var(--yellow); }
.field-group textarea { resize: vertical; min-height: 110px; }

/* VOORKEUR */
.voorkeur-section { margin-bottom: 28px; }
.voorkeur-label { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--dark); display: block; margin-bottom: 14px; }

.dag-keuze { display: flex; gap: 10px; flex-wrap: wrap; }
.dag-opt input { position: absolute; opacity: 0; pointer-events: none; }
.dag-card { padding: 10px 20px; border: 2px solid var(--gray-mid); border-radius: 100px; font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: all 0.15s; display: block; }
.dag-opt:hover .dag-card { border-color: var(--teal); }
.dag-opt input:checked + .dag-card { background: var(--yellow); border-color: var(--yellow); color: var(--dark); }

.contact-keuze { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.contact-opt input { position: absolute; opacity: 0; pointer-events: none; }
.contact-card { border: 2px solid var(--gray-mid); border-radius: var(--radius-lg); padding: 20px 16px; text-align: center; cursor: pointer; transition: all 0.15s; display: flex; flex-direction: column; align-items: center; gap: 6px; }
.contact-card span { font-size: 1.8rem; }
.contact-card strong { font-size: 0.9rem; font-weight: 700; text-transform: none; }
.contact-card p { font-size: 0.75rem; color: var(--gray-text); font-weight: 400; text-transform: none; }
.contact-opt:hover .contact-card { border-color: var(--teal); }
.contact-opt input:checked + .contact-card { border-color: var(--yellow); background: rgba(255,240,1,0.08); }

/* STEP SUMMARY */
.step-summary {
  background: var(--gray-light);
  border-radius: var(--radius);
  padding: 16px 20px;
  margin-bottom: 28px;
  font-size: 0.82rem;
  color: var(--gray-text);
  line-height: 1.8;
  display: none;
}

.step-summary.visible { display: block; }

/* NAV */
.step-nav {
  display: flex;
  gap: 12px;
  align-items: center;
}

.next-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.next-btn:disabled:hover { transform: none; box-shadow: none; }

/* SUCCESS */
.success-wrap { text-align: center; padding: 20px 0; }
.success-icon { font-size: 4rem; margin-bottom: 20px; }
.success-wrap h2 { font-size: 2rem; margin-bottom: 14px; }
.success-wrap > p { color: var(--gray-text); max-width: 440px; margin: 0 auto 24px; font-size: 0.95rem; line-height: 1.7; font-weight: 400; }
.success-details { background: var(--gray-light); border-radius: var(--radius); padding: 16px 24px; display: inline-block; text-align: left; }
.success-details p { font-size: 0.85rem; color: var(--gray-text); }

@media (max-width: 700px) {
  .form-step { padding: 32px 24px 28px; }
  .dienst-keuze { grid-template-columns: 1fr; }
  .form-fields { grid-template-columns: 1fr; }
  .contact-keuze { grid-template-columns: 1fr; }
  .progress-bar { padding: 20px 24px; }
  .ps-line { min-width: 20px; }
  .ps-step span { display: none; }
}
</style>

<script>
// ── Step navigation ──────────────────────────────────────
const steps = document.querySelectorAll('.form-step');
const psSteps = document.querySelectorAll('.ps-step');
const psLines = document.querySelectorAll('.ps-line');

function goToStep(n: number) {
  steps.forEach(s => s.classList.remove('active'));
  document.getElementById(`step-${n}`)?.classList.add('active');

  // progress dots
  psSteps.forEach((s, i) => {
    s.classList.remove('active', 'done');
    if (i + 1 < n) s.classList.add('done');
    if (i + 1 === n) s.classList.add('active');
  });

  // progress lines
  psLines.forEach((l, i) => {
    l.classList.toggle('done', i + 1 < n);
  });

  // scroll to top of form
  document.querySelector('.form-wrap')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// Next/prev buttons
document.querySelectorAll('.next-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const next = parseInt((btn as HTMLElement).dataset.next || '0');
    if (next === 4) buildSummary();
    goToStep(next);
  });
});

document.querySelectorAll('.prev-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const prev = parseInt((btn as HTMLElement).dataset.prev || '0');
    goToStep(prev);
  });
});

// ── Step 1: enable next when dienst selected ─────────────
const dienstRadios = document.querySelectorAll('input[name="dienst"]');
const step1Next = document.querySelector('.form-step#step-1 .next-btn') as HTMLButtonElement;

dienstRadios.forEach(r => {
  r.addEventListener('change', () => {
    if (step1Next) step1Next.disabled = false;
  });
});

// ── Step 4: build summary ────────────────────────────────
function buildSummary() {
  const dienst = (document.querySelector('input[name="dienst"]:checked') as HTMLInputElement)?.value || '—';
  const bedrijf = (document.getElementById('bedrijfsnaam') as HTMLInputElement)?.value || '—';
  const branche = (document.getElementById('branche') as HTMLInputElement)?.value || '—';
  const contactwijze = (document.querySelector('input[name="contactwijze"]:checked') as HTMLInputElement)?.value || '—';
  const dagen = Array.from(document.querySelectorAll('input[name="dag"]:checked'))
    .map(el => (el as HTMLInputElement).value)
    .join(', ') || '—';

  const summary = document.getElementById('step-summary');
  if (!summary) return;
  summary.innerHTML = `
    <strong>Jouw aanvraag samengevat:</strong><br/>
    📋 Onderwerp: <strong>${dienst}</strong><br/>
    🏢 Bedrijf: <strong>${bedrijf}</strong> (${branche})<br/>
    📅 Voorkeursdag(en): <strong>${dagen}</strong><br/>
    🤝 Contact via: <strong>${contactwijze}</strong>
  `;
  summary.classList.add('visible');
}

// ── Submit ───────────────────────────────────────────────
document.getElementById('submit-btn')?.addEventListener('click', () => {
  const naam = (document.getElementById('naam') as HTMLInputElement)?.value;
  const email = (document.getElementById('email') as HTMLInputElement)?.value;
  const tel = (document.getElementById('telefoon') as HTMLInputElement)?.value;
  if (!naam || !email || !tel) {
    alert('Vul alle verplichte velden in (naam, e-mail, telefoon).');
    return;
  }
  goToStep(0); // hide all
  document.getElementById('step-success')?.classList.add('active');
  // Update progress to all done
  psSteps.forEach(s => { s.classList.remove('active'); s.classList.add('done'); });
  psLines.forEach(l => l.classList.add('done'));
});
</script>
