---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contact — Bel Peter | Gratis Kennismaking in Twente"
  description="Neem contact op met Peter Rutgers voor een gratis kennismaking. Zichtbaarheidspartner in Twente voor fotografie, social media en websites."
>
  <section style="background:var(--teal);padding:88px 0 64px;text-align:center;">
    <div class="container">
      <span class="tag" style="background:rgba(255,255,255,0.2);color:var(--white);margin-bottom:16px;display:inline-block;">Contact</span>
      <h1 style="font-size:clamp(2rem,4vw,3.2rem);font-weight:800;color:var(--white);letter-spacing:-0.03em;margin-bottom:16px;">Laten we kennismaken</h1>
      <p style="color:rgba(255,255,255,0.85);max-width:480px;margin:0 auto;font-size:1.05rem;line-height:1.7;">Stel je vraag of plan een gratis kennismaking. Peter reageert doorgaans binnen 24 uur.</p>
      <div style="display:flex;justify-content:center;gap:20px;margin-top:28px;flex-wrap:wrap;">
        <a href="tel:+31851155136" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6 6l.91-.91a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21.73 16"/></svg>
          085 115 5136
        </a>
        <a href="mailto:peter@fotograafpeter.nl" class="btn btn-outline-white">peter@fotograafpeter.nl</a>
      </div>
    </div>
  </section>

  <section style="background:var(--yellow);padding:16px 0;">
    <div class="container" style="text-align:center;">
      <p style="font-size:0.85rem;font-weight:700;color:var(--dark);">📍 Jouw zichtbaarheidspartner in Twente — Nijverdal, Almelo, Hengelo, Enschede & omgeving</p>
    </div>
  </section>

  <section>
    <div class="container contact-layout">
      <div class="contact-form-col">
        <h2>Stuur een bericht</h2>
        <p style="color:var(--gray-text);margin-bottom:28px;">Vul het formulier in en Peter neemt contact met je op.</p>
        <form class="cform">
          <div class="cform-row">
            <div class="cform-group">
              <label>Naam *</label>
              <input type="text" placeholder="Jouw naam" required/>
            </div>
            <div class="cform-group">
              <label>Bedrijfsnaam</label>
              <input type="text" placeholder="Jouw bedrijf"/>
            </div>
          </div>
          <div class="cform-group">
            <label>E-mailadres *</label>
            <input type="email" placeholder="jouw@email.nl" required/>
          </div>
          <div class="cform-group">
            <label>Telefoonnummer</label>
            <input type="tel" placeholder="085 115 5136"/>
          </div>
          <div class="cform-group">
            <label>Ik ben geïnteresseerd in</label>
            <select>
              <option>Maak een keuze</option>
              <option>Fotografie</option>
              <option>Social Media</option>
              <option>Website</option>
              <option>Combinatiepakket</option>
              <option>Weet ik nog niet</option>
            </select>
          </div>
          <div class="cform-group">
            <label>Bericht *</label>
            <textarea rows="5" placeholder="Vertel iets over jouw bedrijf en wat je wil bereiken in Twente..." required></textarea>
          </div>
          <button type="submit" class="btn btn-teal" style="width:100%;justify-content:center;">
            Verstuur bericht
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M9 4L13 8L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          </button>
        </form>
      </div>

      <div class="contact-info-col">
        <div class="cinfo-card" style="border-top:4px solid var(--teal);">
          <h3>Directe contactinfo</h3>
          <div class="cinfo-items">
            <a href="tel:+31851155136" class="cinfo-item">
              <div class="cinfo-icon" style="background:var(--teal-light);color:var(--teal);">📞</div>
              <div><strong>085 115 5136</strong><span>Ma–vr 09:00–17:00</span></div>
            </a>
            <a href="mailto:peter@fotograafpeter.nl" class="cinfo-item">
              <div class="cinfo-icon" style="background:rgba(255,240,1,0.2);color:#7a6a00;">✉️</div>
              <div><strong>peter@fotograafpeter.nl</strong><span>Reactie binnen 24 uur</span></div>
            </a>
            <div class="cinfo-item">
              <div class="cinfo-icon" style="background:var(--sky-light);color:#0369a1;">📍</div>
              <div><strong>Nijverdal, Twente</strong><span>Actief in heel Overijssel</span></div>
            </div>
          </div>
        </div>

        <div class="cinfo-card" style="background:var(--dark);">
          <h3 style="color:var(--white);">Gratis kennismaking</h3>
          <p style="color:rgba(255,255,255,0.65);font-size:0.88rem;line-height:1.65;margin-bottom:20px;">Plan een gesprek van 30 minuten. Geen verplichtingen, gewoon een eerlijk gesprek over jouw wensen en hoe Peter kan helpen.</p>
          <a href="mailto:peter@fotograafpeter.nl?subject=Gratis kennismaking aanvragen" class="btn btn-primary" style="width:100%;justify-content:center;">Kennismaking plannen</a>
        </div>

        <div class="cinfo-card" style="background:var(--yellow);">
          <h3>Fotografie nodig?</h3>
          <p style="font-size:0.88rem;color:rgba(20,18,19,0.7);line-height:1.65;margin-bottom:16px;">Bezoek fotograafpeter.nl voor het portfolio en meer info over bedrijfsfotografie in Twente.</p>
          <a href="https://fotograafpeter.nl" target="_blank" class="btn btn-outline-dark" style="width:100%;justify-content:center;">Naar fotograafpeter.nl →</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
.contact-layout { display: grid; grid-template-columns: 1.2fr 1fr; gap: 60px; align-items: start; }
.contact-form-col h2 { font-size: 1.4rem; font-weight: 800; margin-bottom: 8px; letter-spacing: -0.02em; }
.cform { display: flex; flex-direction: column; gap: 18px; }
.cform-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.cform-group { display: flex; flex-direction: column; gap: 6px; }
.cform-group label { font-size: 0.82rem; font-weight: 700; color: var(--dark); }
.cform-group input, .cform-group select, .cform-group textarea { padding: 12px 16px; border: 2px solid var(--gray-mid); border-radius: var(--radius); font-size: 0.9rem; font-family: var(--font-body); color: var(--dark); background: var(--white); transition: border-color 0.15s; outline: none; }
.cform-group input:focus, .cform-group select:focus, .cform-group textarea:focus { border-color: var(--teal); }
.cform-group textarea { resize: vertical; min-height: 120px; }

.contact-info-col { display: flex; flex-direction: column; gap: 20px; }
.cinfo-card { background: var(--gray-light); border-radius: var(--radius-lg); padding: 28px; }
.cinfo-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: 16px; }
.cinfo-items { display: flex; flex-direction: column; gap: 12px; }
.cinfo-item { display: flex; align-items: center; gap: 14px; padding: 12px; background: var(--white); border-radius: var(--radius); color: var(--dark); text-decoration: none; transition: box-shadow 0.15s; }
a.cinfo-item:hover { box-shadow: 0 4px 16px rgba(21,186,179,0.15); }
.cinfo-icon { width: 40px; height: 40px; border-radius: var(--radius); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; }
.cinfo-item strong { display: block; font-size: 0.88rem; font-weight: 700; }
.cinfo-item span { display: block; font-size: 0.78rem; color: var(--gray-text); margin-top: 1px; }

@media (max-width: 900px) {
  .contact-layout { grid-template-columns: 1fr; }
  .cform-row { grid-template-columns: 1fr; }
}
</style>
