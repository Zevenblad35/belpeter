---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Kennismaking Plannen — Bel Peter | Gratis Gesprek" description="Plan een gratis kennismakingsgesprek met Peter. Social media of website in Twente. Vrijblijvend en snel geregeld." canonical="https://belpeter.nl/contact/">

<section class="ch"><div class="container"><span class="eyebrow">Contact</span><h1>Laten we kennismaken</h1><p>Vul het formulier in en Peter neemt contact met je op. Gratis en vrijblijvend.</p><div class="ch-meta"><a href="tel:+31851155136">📞 085 115 5136</a><span>·</span><a href="mailto:peter@belpeter.nl">✉️ peter@belpeter.nl</a><span>·</span><span>📍 Nijverdal, Twente</span></div></div></section>

<section class="section bg-white"><div class="container">
  <div class="contact-lay">
    <div class="form-wrap">
      <div class="prog" id="prog">
        <div class="ps active" data-step="1"><div class="pd">1</div><span>Onderwerp</span></div>
        <div class="pl"></div>
        <div class="ps" data-step="2"><div class="pd">2</div><span>Details</span></div>
        <div class="pl"></div>
        <div class="ps" data-step="3"><div class="pd">3</div><span>Voorkeur</span></div>
        <div class="pl"></div>
        <div class="ps" data-step="4"><div class="pd">4</div><span>Contact</span></div>
      </div>

      <div class="fstep" id="s1">
        <h2>Waarvoor wil je kennismaken?</h2>
        <p>Selecteer het onderwerp van jouw gesprek met Peter.</p>
        <div class="subj-g">
          <label class="subj-c"><input type="radio" name="subj" value="fotografie"/><div class="subj-i"><span style="font-size:28px">📸</span><strong>Fotografie</strong><span>Bedrijfsfotografie, portretten of productfotografie</span></div></label>
          <label class="subj-c"><input type="radio" name="subj" value="social-media"/><div class="subj-i"><span style="font-size:28px">📱</span><strong>Social Media</strong><span>Strategie, contentcreatie of beheer</span></div></label>
          <label class="subj-c"><input type="radio" name="subj" value="website"/><div class="subj-i"><span style="font-size:28px">💻</span><strong>Website</strong><span>Nieuwe website of verbetering huidige site</span></div></label>
          <label class="subj-c"><input type="radio" name="subj" value="alles"/><div class="subj-i"><span style="font-size:28px">🚀</span><strong>Alles / combinatie</strong><span>Ik wil mijn volledige online zichtbaarheid verbeteren</span></div></label>
        </div>
        <div class="snav"><span></span><button class="btn btn-primary" onclick="goStep(2)">Volgende stap →</button></div>
      </div>

      <div class="fstep hidden" id="s2">
        <h2>Vertel iets over jouw bedrijf</h2>
        <p>Zodat Peter goed voorbereid het gesprek in kan gaan.</p>
        <div class="ffields">
          <div class="fg"><label for="bn">Bedrijfsnaam <span class="req">*</span></label><input type="text" id="bn" placeholder="Jouw bedrijfsnaam" required/></div>
          <div class="fg"><label for="br">Branche <span class="req">*</span></label><input type="text" id="br" placeholder="Bijv. horeca, bouw, zorg..." required/></div>
          <div class="fg"><label for="zb">Wat heb je al aan zichtbaarheid? <span class="req">*</span></label><textarea id="zb" rows="3" placeholder="Heb je al een website, social media kanalen, etc.?"></textarea></div>
        </div>
        <div class="snav"><button class="btn btn-outline" onclick="goStep(1)">← Terug</button><button class="btn btn-primary" onclick="goStep(3)">Volgende stap →</button></div>
      </div>

      <div class="fstep hidden" id="s3">
        <h2>Wanneer en hoe stel jij het voor?</h2>
        <p>Peter is beschikbaar van dinsdag t/m vrijdag overdag.</p>
        <div class="ffields">
          <div class="fg"><label>Voorkeursdag(en)</label><div class="cb-row"><label class="cbo"><input type="checkbox" value="di"/> Dinsdag</label><label class="cbo"><input type="checkbox" value="wo"/> Woensdag</label><label class="cbo"><input type="checkbox" value="do"/> Donderdag</label><label class="cbo"><input type="checkbox" value="vr"/> Vrijdag</label></div></div>
          <div class="fg"><label>Voorkeur voor contact <span class="req">*</span></label>
            <div class="pref-g">
              <label class="pref-c"><input type="radio" name="pref" value="tel"/><div class="pref-i"><span>📞</span><strong>Telefoon</strong><span>Gewoon even bellen</span></div></label>
              <label class="pref-c"><input type="radio" name="pref" value="video"/><div class="pref-i"><span>💻</span><strong>Beeldbellen</strong><span>Teams of Zoom</span></div></label>
              <label class="pref-c"><input type="radio" name="pref" value="f2f"/><div class="pref-i"><span>🤝</span><strong>Face to face</strong><span>Bij jou of Nijverdal</span></div></label>
            </div>
          </div>
        </div>
        <div class="snav"><button class="btn btn-outline" onclick="goStep(2)">← Terug</button><button class="btn btn-primary" onclick="goStep(4)">Volgende stap →</button></div>
      </div>

      <div class="fstep hidden" id="s4">
        <h2>Jouw contactgegevens</h2>
        <p>Zodat Peter je kan bereiken om de afspraak te bevestigen.</p>
        <div class="ffields">
          <div class="fg"><label for="nm">Naam <span class="req">*</span></label><input type="text" id="nm" placeholder="Jouw naam" required/></div>
          <div class="fg"><label for="tel">Telefoonnummer <span class="req">*</span></label><input type="tel" id="tel" placeholder="06 12345678" required/></div>
          <div class="fg"><label for="em">E-mailadres <span class="req">*</span></label><input type="email" id="em" placeholder="jouw@email.nl" required/></div>
          <div class="fg"><label for="op">Aanvullende opmerkingen</label><textarea id="op" rows="3" placeholder="Iets anders dat Peter moet weten?"></textarea></div>
        </div>
        <div class="snav"><button class="btn btn-outline" onclick="goStep(3)">← Terug</button><button class="btn btn-primary" onclick="doSubmit()">Verstuur aanvraag ✓</button></div>
      </div>

      <div class="fstep hidden" id="s-ok">
        <div class="ok-box">
          <span style="font-size:64px;display:block;margin-bottom:20px">🎉</span>
          <h2>Aanvraag ontvangen!</h2>
          <p>Bedankt voor je aanvraag. Peter neemt zo snel mogelijk contact met je op om de kennismaking in te plannen.</p>
          <div class="ok-meta"><p>💌 Je ontvangt een bevestiging op jouw e-mailadres.</p><p>⏱️ Peter reageert doorgaans binnen 1 werkdag.</p></div>
          <a href="/" class="btn btn-primary">Terug naar home</a>
        </div>
      </div>
    </div>

    <aside class="contact-side">
      <div class="card">
        <img src="https://www.peterrutgersmedia.nl/wp-content/uploads/2025/11/peter-metcamera-1024x747.jpg" alt="Peter Rutgers" style="width:100%;height:180px;object-fit:cover;object-position:top;border-radius:var(--r-sm);margin-bottom:16px" loading="lazy"/>
        <h4>Direct contact</h4>
        <div class="sc-list">
          <a href="tel:+31851155136" class="sc-l">📞 085 115 5136</a>
          <a href="mailto:peter@belpeter.nl" class="sc-l">✉️ peter@belpeter.nl</a>
          <div class="sc-l">📍 Nijverdal, Twente</div>
        </div>
      </div>
      <div class="card" style="background:var(--gray-50)">
        <h4>Wat je kunt verwachten</h4>
        <ul class="check-list" style="margin-top:12px">
          <li>Reactie binnen 1 werkdag</li>
          <li>Gratis en vrijblijvend</li>
          <li>Geen standaard verkooppraatje</li>
          <li>Eerlijk advies over wat past</li>
        </ul>
      </div>
    </aside>
  </div>
</div></section>

<script>
let cur = 1;
function goStep(n) {
  document.getElementById('s'+cur).classList.add('hidden');
  document.getElementById('s'+n).classList.remove('hidden');
  cur = n;
  document.querySelectorAll('.ps').forEach((el,i)=>{
    el.classList.toggle('active', i+1<=n);
    el.classList.toggle('done', i+1<n);
  });
  document.querySelectorAll('.pl').forEach((el,i)=>{
    el.style.background = i+1 < n ? 'var(--blue)' : 'var(--gray-200)';
  });
  window.scrollTo({top:0,behavior:'smooth'});
}
function doSubmit() {
  document.getElementById('s4').classList.add('hidden');
  document.getElementById('s-ok').classList.remove('hidden');
  document.getElementById('prog').classList.add('hidden');
  window.scrollTo({top:0,behavior:'smooth'});
}
document.addEventListener('DOMContentLoaded', () => {
  document.querySelectorAll('.subj-c,.pref-c').forEach(c => {
    c.addEventListener('click', () => {
      const inp = c.querySelector('input');
      if(!inp) return;
      document.querySelectorAll(`[name="${inp.name}"]`).forEach(r => r.closest('.subj-c,.pref-c')?.classList.remove('sel'));
      c.classList.add('sel');
    });
  });
});
</script>

</Layout>
<style>
.ch{background:#F5C518;padding:72px 0 64px;text-align:center}
.ch h1{margin:10px 0 14px}.ch p{font-size:18px;max-width:540px;margin:0 auto 20px}
.ch-meta{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;font-size:15px}
.ch-meta a{color:#1a1a1a;font-weight:600}
.contact-lay{display:grid;grid-template-columns:1fr 320px;gap:48px;align-items:start}
.prog{display:flex;align-items:center;margin-bottom:36px}
.ps{display:flex;align-items:center;gap:8px}
.pd{width:32px;height:32px;border-radius:50%;border:2px solid var(--gray-200);background:#fff;color:var(--gray-500);font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center;transition:all .2s}
.ps.active .pd{border-color:var(--blue);background:var(--blue);color:#fff}
.ps.done .pd{border-color:var(--green);background:var(--green);color:#fff}
.ps span{font-size:13px;font-weight:500;color:var(--gray-500)}
.ps.active span,.ps.done span{color:#1a1a1a}
.pl{flex:1;height:2px;background:var(--gray-200);margin:0 8px;transition:background .2s}
.fstep h2{margin-bottom:8px}.fstep>p{margin-bottom:24px}
.hidden{display:none!important}
.subj-g{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:28px}
.subj-c{cursor:pointer}.subj-c input{position:absolute;opacity:0;pointer-events:none}
.subj-i{display:flex;flex-direction:column;gap:4px;padding:18px 16px;border:1.5px solid var(--gray-200);border-radius:var(--r-md);transition:all .15s}
.subj-c:hover .subj-i,.subj-c.sel .subj-i{border-color:var(--blue)}
.subj-c.sel .subj-i{background:var(--blue-section)}
.subj-i strong{font-size:15px;font-weight:700;color:#1a1a1a}
.subj-i span:last-child{font-size:13px;color:var(--gray-500)}
.ffields{display:flex;flex-direction:column;gap:20px;margin-bottom:28px}
.fg{display:flex;flex-direction:column;gap:6px}
.fg label{font-size:14px;font-weight:600;color:#1a1a1a}
.req{color:var(--blue)}
.fg input,.fg textarea{padding:12px 14px;border:1.5px solid var(--gray-200);border-radius:var(--r-sm);font-size:15px;font-family:inherit;color:#1a1a1a;transition:border-color .15s;width:100%}
.fg input:focus,.fg textarea:focus{outline:none;border-color:var(--blue)}
.fg textarea{resize:vertical}
.cb-row{display:flex;gap:12px;flex-wrap:wrap}
.cbo{display:flex;align-items:center;gap:8px;padding:8px 16px;border:1.5px solid var(--gray-200);border-radius:var(--r-pill);font-size:14px;font-weight:500;cursor:pointer;transition:all .15s}
.cbo:has(input:checked){border-color:var(--blue);background:var(--blue-section);color:var(--blue-dark)}
.cbo input{position:absolute;opacity:0}
.pref-g{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.pref-c{cursor:pointer}.pref-c input{position:absolute;opacity:0;pointer-events:none}
.pref-i{display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center;padding:16px 12px;border:1.5px solid var(--gray-200);border-radius:var(--r-md);transition:all .15s}
.pref-i span:first-child{font-size:24px}
.pref-i strong{font-size:14px;font-weight:700;color:#1a1a1a}
.pref-i span:last-child{font-size:12px;color:var(--gray-500)}
.pref-c:hover .pref-i,.pref-c.sel .pref-i{border-color:var(--blue);background:var(--blue-section)}
.snav{display:flex;justify-content:space-between;align-items:center}
.ok-box{text-align:center;padding:40px 0}
.ok-box h2{margin-bottom:14px}.ok-box p{margin-bottom:14px}
.ok-meta{background:var(--gray-50);border-radius:var(--r-md);padding:20px;margin:24px 0 32px;text-align:left}
.ok-meta p{margin-bottom:8px;font-size:15px}
.contact-side{display:flex;flex-direction:column;gap:16px}
.sc-list{display:flex;flex-direction:column;gap:10px;margin-top:12px}
.sc-l{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:500;color:#1a1a1a;padding:10px 0;border-bottom:.5px solid var(--gray-200)}
.sc-l:last-child{border-bottom:none}
a.sc-l:hover{color:var(--blue)}
@media(max-width:900px){.contact-lay{grid-template-columns:1fr}.contact-side{order:-1}.subj-g,.pref-g{grid-template-columns:1fr}}
</style>
