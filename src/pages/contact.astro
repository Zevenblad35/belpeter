---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Kennismaking Plannen — Bel Peter | Gratis Gesprek"
  description="Plan een gratis kennismakingsgesprek met Peter. Social media of website in Twente. Vrijblijvend en snel geregeld."
  canonical="https://belpeter.nl/contact/"
>

<!-- ─── CONTACT HERO ───────────────────────── -->
<section class="contact-hero">
  <div class="container">
    <span class="eyebrow">Contact</span>
    <h1>Laten we<br>kennismaken</h1>
    <p>Vul het formulier in en Peter neemt contact met je op om een afspraak te plannen. Gratis en vrijblijvend.</p>
    <div class="contact-meta">
      <a href="tel:+31851155136">📞 085 115 5136</a>
      <span>·</span>
      <a href="mailto:peter@belpeter.nl">✉️ peter@belpeter.nl</a>
      <span>·</span>
      <span>📍 Nijverdal, Twente</span>
    </div>
  </div>
</section>

<!-- ─── FORM + SIDEBAR ─────────────────────── -->
<section class="section bg-white">
  <div class="container">
    <div class="contact-layout">

      <!-- Multi-step form -->
      <div class="form-wrap">
        <!-- Progress bar -->
        <div class="progress-bar" id="progress-bar">
          <div class="progress-step active" data-step="1">
            <div class="step-dot">1</div>
            <span>Onderwerp</span>
          </div>
          <div class="progress-line"></div>
          <div class="progress-step" data-step="2">
            <div class="step-dot">2</div>
            <span>Details</span>
          </div>
          <div class="progress-line"></div>
          <div class="progress-step" data-step="3">
            <div class="step-dot">3</div>
            <span>Voorkeur</span>
          </div>
          <div class="progress-line"></div>
          <div class="progress-step" data-step="4">
            <div class="step-dot">4</div>
            <span>Contact</span>
          </div>
        </div>

        <!-- Step 1: Onderwerp -->
        <div class="form-step" id="step-1">
          <h2>Waarvoor wil je<br>kennismaken?</h2>
          <p>Selecteer het onderwerp van jouw kennismakingsgesprek met Peter.</p>
          <div class="subject-grid">
            <label class="subject-card">
              <input type="radio" name="subject" value="fotografie" />
              <div class="subject-inner">
                <span class="subject-icon" aria-hidden="true">📸</span>
                <strong>Fotografie</strong>
                <span>Bedrijfsfotografie, portretten of productfotografie in Twente</span>
              </div>
            </label>
            <label class="subject-card">
              <input type="radio" name="subject" value="social-media" />
              <div class="subject-inner">
                <span class="subject-icon" aria-hidden="true">📱</span>
                <strong>Social Media</strong>
                <span>Strategie, contentcreatie of beheer van jouw social kanalen</span>
              </div>
            </label>
            <label class="subject-card">
              <input type="radio" name="subject" value="website" />
              <div class="subject-inner">
                <span class="subject-icon" aria-hidden="true">💻</span>
                <strong>Website</strong>
                <span>Nieuwe website of verbetering van jouw huidige website</span>
              </div>
            </label>
            <label class="subject-card">
              <input type="radio" name="subject" value="alles" />
              <div class="subject-inner">
                <span class="subject-icon" aria-hidden="true">🚀</span>
                <strong>Alles / combinatie</strong>
                <span>Ik wil mijn volledige online zichtbaarheid verbeteren</span>
              </div>
            </label>
          </div>
          <div class="step-nav">
            <span></span>
            <button class="btn btn-primary" onclick="nextStep(2)">Volgende stap →</button>
          </div>
        </div>

        <!-- Step 2: Details -->
        <div class="form-step hidden" id="step-2">
          <h2>Vertel iets over<br>jouw bedrijf</h2>
          <p>Zodat Peter goed voorbereid het gesprek in kan gaan.</p>
          <div class="form-fields">
            <div class="field-group">
              <label for="bedrijfsnaam">Bedrijfsnaam <span class="req">*</span></label>
              <input type="text" id="bedrijfsnaam" name="bedrijfsnaam" placeholder="Jouw bedrijfsnaam" required />
            </div>
            <div class="field-group">
              <label for="branche">Branche <span class="req">*</span></label>
              <input type="text" id="branche" name="branche" placeholder="Bijv. horecá, bouw, zorg..." required />
            </div>
            <div class="field-group">
              <label for="zichtbaarheid">Wat heb je al aan zichtbaarheid? <span class="req">*</span></label>
              <textarea id="zichtbaarheid" name="zichtbaarheid" rows="3" placeholder="Heb je al een website, social media kanalen, etc.?"></textarea>
            </div>
          </div>
          <div class="step-nav">
            <button class="btn btn-outline" onclick="nextStep(1)">← Terug</button>
            <button class="btn btn-primary" onclick="nextStep(3)">Volgende stap →</button>
          </div>
        </div>

        <!-- Step 3: Voorkeur -->
        <div class="form-step hidden" id="step-3">
          <h2>Wanneer en hoe<br>stel jij het voor?</h2>
          <p>Peter is beschikbaar van dinsdag t/m vrijdag overdag.</p>
          <div class="form-fields">
            <div class="field-group">
              <label>Voorkeursdag(en)</label>
              <div class="checkbox-row">
                <label class="check-opt"><input type="checkbox" name="dag" value="dinsdag" /> Dinsdag</label>
                <label class="check-opt"><input type="checkbox" name="dag" value="woensdag" /> Woensdag</label>
                <label class="check-opt"><input type="checkbox" name="dag" value="donderdag" /> Donderdag</label>
                <label class="check-opt"><input type="checkbox" name="dag" value="vrijdag" /> Vrijdag</label>
              </div>
            </div>
            <div class="field-group">
              <label>Voorkeur voor contact <span class="req">*</span></label>
              <div class="contact-pref-grid">
                <label class="pref-card">
                  <input type="radio" name="contact_pref" value="telefoon" />
                  <div class="pref-inner">
                    <span aria-hidden="true">📞</span>
                    <strong>Telefoon</strong>
                    <span>Gewoon even bellen</span>
                  </div>
                </label>
                <label class="pref-card">
                  <input type="radio" name="contact_pref" value="beeldbellen" />
                  <div class="pref-inner">
                    <span aria-hidden="true">💻</span>
                    <strong>Beeldbellen</strong>
                    <span>Via Teams of Zoom</span>
                  </div>
                </label>
                <label class="pref-card">
                  <input type="radio" name="contact_pref" value="face-to-face" />
                  <div class="pref-inner">
                    <span aria-hidden="true">🤝</span>
                    <strong>Face to face</strong>
                    <span>Bij jou of in Nijverdal</span>
                  </div>
                </label>
              </div>
            </div>
          </div>
          <div class="step-nav">
            <button class="btn btn-outline" onclick="nextStep(2)">← Terug</button>
            <button class="btn btn-primary" onclick="nextStep(4)">Volgende stap →</button>
          </div>
        </div>

        <!-- Step 4: Contactgegevens -->
        <div class="form-step hidden" id="step-4">
          <h2>Jouw contactgegevens</h2>
          <p>Zodat Peter je kan bereiken om de afspraak te bevestigen.</p>
          <div class="form-fields">
            <div class="field-group">
              <label for="naam">Naam <span class="req">*</span></label>
              <input type="text" id="naam" name="naam" placeholder="Jouw naam" required />
            </div>
            <div class="field-group">
              <label for="telefoon">Telefoonnummer <span class="req">*</span></label>
              <input type="tel" id="telefoon" name="telefoon" placeholder="06 12345678" required />
            </div>
            <div class="field-group">
              <label for="email">E-mailadres <span class="req">*</span></label>
              <input type="email" id="email" name="email" placeholder="jouw@email.nl" required />
            </div>
            <div class="field-group">
              <label for="opmerkingen">Aanvullende opmerkingen</label>
              <textarea id="opmerkingen" name="opmerkingen" rows="3" placeholder="Iets anders dat Peter moet weten?"></textarea>
            </div>
          </div>
          <div class="step-nav">
            <button class="btn btn-outline" onclick="nextStep(3)">← Terug</button>
            <button class="btn btn-primary" onclick="submitForm()">Verstuur aanvraag ✓</button>
          </div>
        </div>

        <!-- Success state -->
        <div class="form-step hidden" id="step-success">
          <div class="success-box">
            <div class="success-icon" aria-hidden="true">🎉</div>
            <h2>Aanvraag ontvangen!</h2>
            <p>Bedankt voor je aanvraag. Peter neemt zo snel mogelijk contact met je op om de kennismaking in te plannen.</p>
            <div class="success-meta">
              <p>💌 Je ontvangt een bevestiging op jouw e-mailadres.</p>
              <p>⏱️ Peter reageert doorgaans binnen 1 werkdag.</p>
            </div>
            <a href="/" class="btn btn-primary">Terug naar home</a>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="contact-sidebar">
        <div class="sidebar-card card">
          <img
            src="https://www.peterrutgersmedia.nl/wp-content/uploads/2025/11/peter-metcamera-1024x747.jpg"
            alt="Peter Rutgers"
            style="width:100%;height:180px;object-fit:cover;object-position:top;border-radius:var(--radius-sm);margin-bottom:16px"
            loading="lazy"
          />
          <h4>Direct contact</h4>
          <div class="sidebar-contact">
            <a href="tel:+31851155136" class="sidebar-link">
              <span aria-hidden="true">📞</span> 085 115 5136
            </a>
            <a href="mailto:peter@belpeter.nl" class="sidebar-link">
              <span aria-hidden="true">✉️</span> peter@belpeter.nl
            </a>
            <div class="sidebar-link">
              <span aria-hidden="true">📍</span> Nijverdal, Twente
            </div>
          </div>
        </div>
        <div class="sidebar-promise card">
          <h4>Wat je kunt verwachten</h4>
          <ul class="check-list" style="margin-top:12px">
            <li>Reactie binnen 1 werkdag</li>
            <li>Gratis en vrijblijvend</li>
            <li>Geen standaard verkooppraatje</li>
            <li>Eerlijk advies over wat past</li>
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  let currentStep = 1;

  function nextStep(step: number) {
    document.getElementById(`step-${currentStep}`)?.classList.add('hidden');
    document.getElementById(`step-${step}`)?.classList.remove('hidden');
    currentStep = step;
    updateProgress(step);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function updateProgress(step: number) {
    document.querySelectorAll('.progress-step').forEach((el, i) => {
      el.classList.toggle('active', i + 1 <= step);
      el.classList.toggle('done', i + 1 < step);
    });
    document.querySelectorAll('.progress-line').forEach((el, i) => {
      (el as HTMLElement).style.background = i + 1 < step ? 'var(--blue)' : 'var(--gray-200)';
    });
  }

  function submitForm() {
    document.getElementById(`step-4`)?.classList.add('hidden');
    document.getElementById('step-success')?.classList.remove('hidden');
    document.getElementById('progress-bar')?.classList.add('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Select radio on card click
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.subject-card, .pref-card').forEach(card => {
      card.addEventListener('click', () => {
        const input = card.querySelector('input[type="radio"]') as HTMLInputElement;
        if (input) { input.checked = true; card.classList.add('selected'); }
        const name = input?.name;
        document.querySelectorAll(`[name="${name}"]`).forEach(r => {
          (r as HTMLInputElement).closest('.subject-card, .pref-card')?.classList.remove('selected');
        });
        card.classList.add('selected');
      });
    });
  });
</script>

</Layout>

<style>
/* HERO */
.contact-hero { background: var(--yellow); padding: 72px 0 64px; text-align: center; }
.contact-hero h1 { margin: 10px 0 14px; }
.contact-hero p  { font-size: 18px; max-width: 540px; margin: 0 auto 20px; }
.contact-meta { display: flex; align-items: center; justify-content: center; gap: 10px; flex-wrap: wrap; font-size: 15px; }
.contact-meta a { color: var(--black); font-weight: 600; }
.contact-meta a:hover { text-decoration: underline; }

/* LAYOUT */
.contact-layout { display: grid; grid-template-columns: 1fr 320px; gap: 48px; align-items: start; }

/* FORM WRAP */
.form-wrap { background: var(--white); }

/* PROGRESS */
.progress-bar {
  display: flex; align-items: center; margin-bottom: 36px;
}
.progress-step { display: flex; align-items: center; gap: 8px; }
.step-dot {
  width: 32px; height: 32px; border-radius: 50%; border: 2px solid var(--gray-200);
  background: var(--white); color: var(--gray-500);
  font-size: 13px; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  transition: all .2s;
}
.progress-step.active .step-dot { border-color: var(--blue); background: var(--blue); color: var(--white); }
.progress-step.done .step-dot   { border-color: var(--green); background: var(--green); color: var(--white); }
.progress-step span { font-size: 13px; font-weight: 500; color: var(--gray-500); }
.progress-step.active span, .progress-step.done span { color: var(--black); }
.progress-line { flex: 1; height: 2px; background: var(--gray-200); margin: 0 8px; transition: background .2s; }

/* STEP */
.form-step h2 { margin-bottom: 8px; }
.form-step > p { margin-bottom: 24px; }
.hidden { display: none !important; }

/* SUBJECT GRID */
.subject-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 28px; }
.subject-card { cursor: pointer; }
.subject-card input { position: absolute; opacity: 0; pointer-events: none; }
.subject-inner {
  display: flex; flex-direction: column; gap: 4px;
  padding: 20px 18px; border: 1.5px solid var(--gray-200);
  border-radius: var(--radius-md); transition: all .15s;
}
.subject-card:hover .subject-inner { border-color: var(--blue); }
.subject-card.selected .subject-inner { border-color: var(--blue); background: var(--blue-section); }
.subject-icon { font-size: 28px; margin-bottom: 4px; }
.subject-inner strong { font-size: 15px; font-weight: 700; color: var(--black); }
.subject-inner span   { font-size: 13px; color: var(--gray-500); }

/* FORM FIELDS */
.form-fields { display: flex; flex-direction: column; gap: 20px; margin-bottom: 28px; }
.field-group { display: flex; flex-direction: column; gap: 6px; }
.field-group label { font-size: 14px; font-weight: 600; color: var(--black); }
.req { color: var(--blue); }
.field-group input,
.field-group textarea,
.field-group select {
  padding: 12px 14px; border: 1.5px solid var(--gray-200);
  border-radius: var(--radius-sm); font-size: 15px; font-family: inherit;
  color: var(--black); transition: border-color .15s;
  width: 100%;
}
.field-group input:focus,
.field-group textarea:focus { outline: none; border-color: var(--blue); }
.field-group textarea { resize: vertical; }

/* CHECKBOXES */
.checkbox-row { display: flex; gap: 12px; flex-wrap: wrap; }
.check-opt {
  display: flex; align-items: center; gap: 8px;
  padding: 8px 16px; border: 1.5px solid var(--gray-200);
  border-radius: var(--radius-pill); font-size: 14px; font-weight: 500;
  cursor: pointer; transition: all .15s;
}
.check-opt:has(input:checked) { border-color: var(--blue); background: var(--blue-section); color: var(--blue-dark); }
.check-opt input { position: absolute; opacity: 0; }

/* CONTACT PREF */
.contact-pref-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; }
.pref-card { cursor: pointer; }
.pref-card input { position: absolute; opacity: 0; pointer-events: none; }
.pref-inner {
  display: flex; flex-direction: column; align-items: center; gap: 4px; text-align: center;
  padding: 16px 12px; border: 1.5px solid var(--gray-200);
  border-radius: var(--radius-md); transition: all .15s;
}
.pref-inner span:first-child { font-size: 24px; }
.pref-inner strong { font-size: 14px; font-weight: 700; color: var(--black); }
.pref-inner span:last-child { font-size: 12px; color: var(--gray-500); }
.pref-card:hover .pref-inner { border-color: var(--blue); }
.pref-card.selected .pref-inner { border-color: var(--blue); background: var(--blue-section); }

/* STEP NAV */
.step-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 4px; }

/* SUCCESS */
.success-box { text-align: center; padding: 40px 0; }
.success-icon { font-size: 64px; margin-bottom: 20px; display: block; }
.success-box h2 { margin-bottom: 14px; }
.success-box p { margin-bottom: 14px; }
.success-meta {
  background: var(--gray-50); border-radius: var(--radius-md);
  padding: 20px; margin: 24px 0 32px; text-align: left;
}
.success-meta p { margin-bottom: 8px; font-size: 15px; }

/* SIDEBAR */
.contact-sidebar { display: flex; flex-direction: column; gap: 16px; }
.sidebar-contact { display: flex; flex-direction: column; gap: 10px; margin-top: 12px; }
.sidebar-link {
  display: flex; align-items: center; gap: 8px;
  font-size: 14px; font-weight: 500; color: var(--black);
  padding: 10px 0; border-bottom: 0.5px solid var(--gray-200);
}
.sidebar-link:last-child { border-bottom: none; }
a.sidebar-link:hover { color: var(--blue); }
.sidebar-promise { background: var(--gray-50) !important; }

@media (max-width: 900px) {
  .contact-layout { grid-template-columns: 1fr; }
  .contact-sidebar { order: -1; }
  .subject-grid { grid-template-columns: 1fr; }
  .contact-pref-grid { grid-template-columns: 1fr; }
}
</style>
