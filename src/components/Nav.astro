---
const navItems = [
  {
    label: 'Diensten',
    href: '/diensten',
    children: [
      { label: 'Fotografie', href: '/diensten/fotografie', desc: 'Professionele bedrijfsfotografie' },
      { label: 'Social Media', href: '/diensten/social-media', desc: 'Strategie & contentcreatie' },
      { label: 'Websites', href: '/diensten/websites', desc: 'Op maat gemaakte websites' },
    ]
  },
  { label: 'Over Peter', href: '/over' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];
---

<nav class="nav" id="nav">
  <div class="container nav-inner">
    <a href="/" class="nav-logo">
      <span class="logo-bel">BEL</span><span class="logo-peter">PETER</span>
      <span class="logo-sub">· Twente</span>
    </a>

    <ul class="nav-links">
      {navItems.map(item => (
        <li class={item.children ? 'has-dropdown' : ''}>
          <a href={item.href} class="nav-link">
            {item.label}
            {item.children && (
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M2 4L6 8L10 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            )}
          </a>
          {item.children && (
            <div class="dropdown-wrap">
              <div class="dropdown">
                {item.children.map(child => (
                  <a href={child.href} class="dropdown-item">
                    <span class="di-label">{child.label}</span>
                    <span class="di-desc">{child.desc}</span>
                  </a>
                ))}
              </div>
            </div>
          )}
        </li>
      ))}
    </ul>

    <a href="/contact" class="btn btn-primary nav-cta">Gratis kennismaking</a>

    <button class="hamburger" id="hamburger" aria-label="Menu openen">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <ul>
      {navItems.map(item => (
        <li>
          <a href={item.href} class="mob-link">{item.label}</a>
          {item.children && (
            <ul class="mob-sub">
              {item.children.map(child => (
                <li><a href={child.href} class="mob-sub-link">{child.label}</a></li>
              ))}
            </ul>
          )}
        </li>
      ))}
      <li><a href="/contact" class="btn btn-primary" style="margin-top:16px;width:100%;justify-content:center;">Gratis kennismaking</a></li>
    </ul>
  </div>
</nav>

<style>
.nav {
  position: sticky;
  top: 0;
  z-index: 200;
  background: var(--white);
  border-bottom: 3px solid var(--yellow);
  height: var(--nav-height);
  transition: box-shadow 0.2s;
}
.nav.scrolled { box-shadow: 0 4px 24px rgba(0,0,0,0.10); }

.nav-inner {
  display: flex;
  align-items: center;
  height: var(--nav-height);
  gap: 32px;
}

.nav-logo {
  font-family: var(--font);
  font-weight: 900;
  font-size: 1.3rem;
  text-transform: uppercase;
  letter-spacing: -0.02em;
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  gap: 2px;
}
.logo-bel { color: var(--dark); }
.logo-peter { color: var(--teal); }
.logo-sub { font-size: 0.68rem; font-weight: 600; color: var(--gray-text); text-transform: none; letter-spacing: 0; margin-left: 3px; }

.nav-links { display: flex; list-style: none; gap: 2px; flex: 1; }

.has-dropdown { position: relative; }

.nav-link {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 8px 14px;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--dark);
  border-radius: 8px;
  transition: background 0.15s;
  white-space: nowrap;
}
.nav-link:hover { background: var(--yellow); }

/* KEY FIX: wrap creates invisible bridge between link and panel */
.dropdown-wrap {
  position: absolute;
  top: 100%;           /* starts right at bottom of nav-link */
  left: 0;
  padding-top: 6px;    /* invisible 6px tall bridge — mouse stays inside */
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 0.12s, visibility 0.12s;
  z-index: 300;
}

/* Open when hovering the entire <li> (includes both link and wrap) */
.has-dropdown:hover .dropdown-wrap,
.has-dropdown:focus-within .dropdown-wrap {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

.dropdown {
  background: var(--white);
  border: 2px solid var(--yellow);
  border-radius: var(--radius-lg);
  padding: 8px;
  min-width: 240px;
  box-shadow: 0 16px 48px rgba(0,0,0,0.12);
}

.dropdown-item {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 11px 14px;
  border-radius: var(--radius);
  transition: background 0.12s;
}
.dropdown-item:hover { background: rgba(255,240,1,0.15); }

.di-label { font-weight: 700; font-size: 0.875rem; color: var(--dark); }
.di-desc { font-size: 0.75rem; color: var(--gray-text); font-weight: 400; text-transform: none; letter-spacing: 0; }

.nav-cta { margin-left: auto; flex-shrink: 0; font-size: 0.78rem; padding: 10px 20px; }

.hamburger { display: none; flex-direction: column; gap: 5px; background: none; border: none; cursor: pointer; padding: 8px; margin-left: auto; }
.hamburger span { width: 24px; height: 2.5px; background: var(--dark); border-radius: 2px; }

.mobile-menu { display: none; position: absolute; top: var(--nav-height); left: 0; right: 0; background: var(--white); border-bottom: 3px solid var(--yellow); padding: 20px 24px 28px; box-shadow: 0 16px 40px rgba(0,0,0,0.1); }
.mobile-menu.open { display: block; }
.mobile-menu ul { list-style: none; }
.mob-link { display: block; padding: 13px 0; font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.04em; border-bottom: 1px solid var(--gray-light); color: var(--dark); }
.mob-sub { padding-left: 16px; margin-bottom: 8px; }
.mob-sub-link { display: block; padding: 8px 0; font-size: 0.85rem; color: var(--gray-text); font-weight: 500; }

@media (max-width: 900px) {
  .nav-links, .nav-cta { display: none; }
  .hamburger { display: flex; }
}
</style>

<script>
const hamburger = document.getElementById('hamburger');
const mobileMenu = document.getElementById('mobile-menu');
hamburger?.addEventListener('click', () => {
  mobileMenu?.classList.toggle('open');
});
window.addEventListener('scroll', () => {
  document.getElementById('nav')?.classList.toggle('scrolled', window.scrollY > 20);
}, { passive: true });
</script>
