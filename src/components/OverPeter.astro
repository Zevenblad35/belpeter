---
// src/components/OverPeter.astro
---

<section class="over" id="over">
  <div class="container over__inner">

    <!-- Foto links -->
    <div class="over__visual">
      <div class="over__img-wrap">
        <img
          src="https://www.peterrutgersmedia.nl/wp-content/uploads/2025/11/peter-metcamera-1024x747.jpg"
          alt="Peter Rutgers — Bel Peter Nijverdal"
          loading="lazy"
          width="480"
          height="480"
        />
      </div>
      <div class="over__location-badge">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        Nijverdal, Twente
      </div>
    </div>

    <!-- Tekst rechts -->
    <div class="over__content">
      <p class="eyebrow">Wie is Peter?</p>
      <h2 class="over__title">
        Jouw zichtbaarheid<br />is mijn vak
      </h2>
      <p class="over__body">
        Ik ben <strong>Peter Rutgers</strong> uit Nijverdal. Ik help ondernemers en bedrijven
        in Twente om op te vallen — online én offline. Met een sterke website en actieve
        social media zorg ik dat jouw bedrijf gezien wordt door de juiste mensen.
      </p>
      <p class="over__body">
        Als lokale partner ken ik Twente. Ik weet hoe ondernemers hier werken
        en wat hun klanten zoeken.
      </p>

      <div class="over__skills">
        <div class="over__skill">
          <div class="over__skill-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </div>
          <div>
            <strong>Social Media</strong>
            <span>Instagram, LinkedIn &amp; Facebook</span>
          </div>
        </div>
        <div class="over__skill">
          <div class="over__skill-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
          </div>
          <div>
            <strong>Websites</strong>
            <span>SEO-proof &amp; converterend</span>
          </div>
        </div>
      </div>

      <a href="/over" class="btn-primary">Lees Peter's verhaal</a>
    </div>

  </div>
</section>

<style>
  .over {
    background: var(--wit);
    padding: var(--space-2xl) 0;
  }

  .over__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .over__visual {
    position: relative;
  }

  .over__img-wrap {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--blauw-licht);
    max-width: 480px;
    margin: 0 auto;
  }

  .over__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .over__location-badge {
    position: absolute;
    bottom: 1.5rem;
    right: 1rem;
    background: var(--wit);
    border-radius: var(--radius-pill);
    padding: 0.5rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--donkergrijs);
    display: flex;
    align-items: center;
    gap: 0.375rem;
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }

  .over__title {
    font-size: var(--font-size-h2);
    font-weight: 800;
    line-height: 1.15;
    color: var(--zwart);
    margin-bottom: var(--space-md);
  }

  .over__body {
    color: var(--donkergrijs);
    font-size: 1rem;
    max-width: 46ch;
    margin-bottom: 1rem;
  }

  .over__skills {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin: var(--space-md) 0;
  }

  .over__skill {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    background: var(--lichtgrijs);
    border-radius: var(--radius-md);
  }

  .over__skill-icon {
    width: 40px;
    height: 40px;
    background: var(--geel);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--zwart);
  }

  .over__skill div:last-child {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .over__skill strong {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--zwart);
  }

  .over__skill span {
    font-size: 0.8rem;
    color: var(--middelgrijs);
  }

  @media (max-width: 900px) {
    .over__inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .over__img-wrap {
      max-width: 300px;
    }
  }
</style>
