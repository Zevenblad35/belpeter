---
// src/components/Diensten.astro
---

<section class="diensten" id="diensten">
  <div class="container">

    <div class="diensten__header">
      <p class="eyebrow">Wat Peter doet</p>
      <h2 class="diensten__title">Twee diensten,<br />één doel: gezien worden</h2>
      <p class="diensten__intro">
        Peter combineert website- en social media expertise tot een samenhangende aanpak
        die jouw bedrijf zichtbaar maakt in Twente.
      </p>
    </div>

    <!-- Feature block 1 — Social Media -->
    <div class="diensten__feature diensten__feature--left">
      <div class="diensten__feature-visual">
        <div class="diensten__img-circle">
          <img
            src="https://www.peterrutgersmedia.nl/wp-content/uploads/2026/02/preventie-bestrijding-beljoost-384x480.png"
            alt="Social media content voor Twentse ondernemers"
            loading="lazy"
            width="420"
            height="420"
          />
        </div>
        <div class="diensten__num" aria-hidden="true">01</div>
      </div>
      <div class="diensten__feature-text">
        <p class="eyebrow">Social Media</p>
        <h3 class="diensten__feature-title">
          Van strategie tot dagelijks beheer
        </h3>
        <p class="diensten__feature-body">
          Je wilt online aanwezig zijn, maar hebt er geen tijd voor. Peter zorgt voor
          consistente, professionele aanwezigheid op Instagram, LinkedIn en Facebook —
          zodat jij je kunt focussen op je vak.
        </p>
        <ul class="check-list">
          <li>Contentplan &amp; strategie op maat</li>
          <li>Tekst, visuals &amp; Reels</li>
          <li>Community management</li>
          <li>Maandelijkse rapportage</li>
        </ul>
        <a href="/diensten/social-media" class="btn-primary">
          Meer over social media
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
    </div>

    <!-- Feature block 2 — Websites -->
    <div class="diensten__feature diensten__feature--right">
      <div class="diensten__feature-text">
        <p class="eyebrow">Websites</p>
        <h3 class="diensten__feature-title">
          Vindbaar, snel en converterend
        </h3>
        <p class="diensten__feature-body">
          Een website die niet alleen mooi is, maar ook gevonden wordt door jouw klanten
          in Twente. Binnen twee weken online, zonder gedoe.
        </p>
        <ul class="check-list">
          <li>Op maat ontwerp — geen sjabloon gevoel</li>
          <li>SEO-geoptimaliseerd voor Twente</li>
          <li>Mobielvriendelijk &amp; snel</li>
          <li>CMS voor eigen beheer</li>
        </ul>
        <a href="/diensten/websites" class="btn-primary">
          Meer over websites
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
      <div class="diensten__feature-visual">
        <div class="diensten__img-circle diensten__img-circle--blue">
          <img
            src="https://www.peterrutgersmedia.nl/wp-content/uploads/2025/11/peter-metcamera-1024x747.jpg"
            alt="Website gemaakt door Peter Rutgers voor Twente"
            loading="lazy"
            width="420"
            height="420"
          />
        </div>
        <div class="diensten__num diensten__num--right" aria-hidden="true">02</div>
      </div>
    </div>

    <!-- Fotografie promo banner -->
    <div class="diensten__foto-banner">
      <span class="diensten__foto-icon" aria-hidden="true">📸</span>
      <div>
        <strong>Op zoek naar fotografie?</strong>
        Peter is ook actief als professioneel fotograaf voor bedrijven in Twente.
      </div>
      <a href="/diensten/fotografie" class="btn-zwart diensten__foto-cta">Meer info →</a>
    </div>

  </div>
</section>

<style>
  .diensten {
    background: var(--blauw-licht);
    padding: var(--space-2xl) 0;
  }

  .diensten__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--space-xl);
  }

  .diensten__title {
    font-size: var(--font-size-h2);
    font-weight: 800;
    line-height: 1.15;
    color: var(--zwart);
    margin-bottom: var(--space-sm);
  }

  .diensten__intro {
    color: var(--donkergrijs);
    font-size: 1.05rem;
  }

  /* Feature blocks */
  .diensten__feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: center;
    margin-bottom: var(--space-2xl);
  }

  .diensten__feature--right .diensten__feature-visual {
    order: 1;
  }

  .diensten__feature--right .diensten__feature-text {
    order: 0;
  }

  .diensten__feature-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--zwart);
    margin-bottom: 0.75rem;
  }

  .diensten__feature-body {
    color: var(--donkergrijs);
    font-size: 1rem;
    max-width: 44ch;
    margin-bottom: 0.25rem;
  }

  .diensten__feature .check-list {
    margin-bottom: var(--space-md);
  }

  /* Foto cirkel */
  .diensten__feature-visual {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .diensten__img-circle {
    width: 420px;
    height: 420px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--blauw);
    flex-shrink: 0;
  }

  .diensten__img-circle--blue {
    background: var(--geel);
  }

  .diensten__img-circle img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Grote achtergrond nummers */
  .diensten__num {
    position: absolute;
    font-size: 9rem;
    font-weight: 800;
    color: rgba(0,0,0,0.05);
    line-height: 1;
    bottom: -1.5rem;
    left: -1rem;
    pointer-events: none;
    user-select: none;
  }

  .diensten__num--right {
    left: auto;
    right: -1rem;
  }

  /* Fotografie banner */
  .diensten__foto-banner {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: var(--wit);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    font-size: 0.95rem;
    color: var(--donkergrijs);
    border-left: 4px solid var(--geel);
    flex-wrap: wrap;
  }

  .diensten__foto-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .diensten__foto-banner > div {
    flex: 1;
    min-width: 200px;
  }

  .diensten__foto-banner strong {
    font-weight: 700;
    color: var(--zwart);
    display: block;
    margin-bottom: 0.125rem;
  }

  .diensten__foto-cta {
    font-size: 0.875rem;
    padding: 0.625rem 1.25rem;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .diensten__feature {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .diensten__feature--right .diensten__feature-visual {
      order: -1;
    }

    .diensten__img-circle {
      width: 280px;
      height: 280px;
    }

    .diensten__num {
      display: none;
    }
  }
</style>
