---
// src/components/Navbar.astro
---

<header class="navbar">
  <div class="container navbar__inner">

    <a href="/" class="navbar__logo" aria-label="Bel Peter homepage">
      <span class="navbar__logo-text">BELPETER</span>
      <span class="navbar__logo-sub">· Twente</span>
    </a>

    <nav class="navbar__nav" aria-label="Hoofdmenu">
      <ul class="navbar__links">
        <li class="navbar__item navbar__item--dropdown">
          <button class="navbar__link navbar__dropbtn" aria-expanded="false" aria-haspopup="true">
            Diensten
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <ul class="navbar__dropdown" role="menu">
            <li role="none">
              <a href="/diensten/social-media" class="navbar__dropdown-item" role="menuitem">
                <strong>Social Media</strong>
                <span>Strategie &amp; contentcreatie</span>
              </a>
            </li>
            <li role="none">
              <a href="/diensten/websites" class="navbar__dropdown-item" role="menuitem">
                <strong>Websites</strong>
                <span>Op maat gemaakte websites</span>
              </a>
            </li>
            <li role="none">
              <a href="/diensten/fotografie" class="navbar__dropdown-item" role="menuitem">
                <strong>Fotografie</strong>
                <span>Professionele bedrijfsfotografie</span>
              </a>
            </li>
          </ul>
        </li>
        <li><a href="/over" class="navbar__link">Over Peter</a></li>
        <li><a href="/blog" class="navbar__link">Blog</a></li>
        <li><a href="/contact" class="navbar__link">Contact</a></li>
      </ul>
    </nav>

    <a href="/contact" class="btn-zwart navbar__cta">Gratis kennismaking</a>

    <button class="navbar__hamburger" aria-label="Menu openen" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="navbar__mobile" hidden>
    <ul class="navbar__mobile-links">
      <li><a href="/diensten/social-media">Social Media</a></li>
      <li><a href="/diensten/websites">Websites</a></li>
      <li><a href="/diensten/fotografie">Fotografie</a></li>
      <li><a href="/over">Over Peter</a></li>
      <li><a href="/blog">Blog</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
    <a href="/contact" class="btn-zwart navbar__mobile-cta">Gratis kennismaking</a>
  </div>
</header>

<style>
  .navbar {
    background: var(--geel);
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 1px 0 rgba(0,0,0,0.08);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 68px;
  }

  .navbar__logo {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .navbar__logo-text {
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--zwart);
    letter-spacing: -0.02em;
  }

  .navbar__logo-sub {
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(0,0,0,0.5);
  }

  .navbar__nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .navbar__links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .navbar__link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-pill);
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--zwart);
    background: none;
    border: none;
    cursor: pointer;
    transition: background 0.15s;
  }

  .navbar__link:hover {
    background: rgba(0,0,0,0.08);
  }

  /* Dropdown */
  .navbar__item--dropdown {
    position: relative;
  }

  .navbar__dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--wit);
    border-radius: var(--radius-lg);
    box-shadow: 0 4px 24px rgba(0,0,0,0.12);
    min-width: 220px;
    padding: 0.5rem;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(-4px);
    transition: opacity 0.15s, transform 0.15s;
  }

  .navbar__item--dropdown:hover .navbar__dropdown,
  .navbar__item--dropdown:focus-within .navbar__dropdown {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }

  .navbar__dropdown-item {
    display: flex;
    flex-direction: column;
    padding: 0.625rem 0.875rem;
    border-radius: var(--radius-md);
    transition: background 0.1s;
  }

  .navbar__dropdown-item:hover {
    background: var(--lichtgrijs);
  }

  .navbar__dropdown-item strong {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--zwart);
  }

  .navbar__dropdown-item span {
    font-size: 0.8rem;
    color: var(--middelgrijs);
    margin-top: 1px;
  }

  .navbar__cta {
    flex-shrink: 0;
    font-size: 0.9rem;
    padding: 0.625rem 1.25rem;
  }

  /* Hamburger */
  .navbar__hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin-left: auto;
  }

  .navbar__hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--zwart);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  /* Mobile menu */
  .navbar__mobile {
    background: var(--wit);
    border-top: 1px solid rgba(0,0,0,0.1);
    padding: 1.25rem var(--container-pad) 1.5rem;
  }

  .navbar__mobile-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }

  .navbar__mobile-links a {
    display: block;
    padding: 0.625rem 0.5rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--zwart);
    border-bottom: 1px solid var(--lichtgrijs);
  }

  .navbar__mobile-cta {
    width: 100%;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .navbar__nav,
    .navbar__cta {
      display: none;
    }

    .navbar__hamburger {
      display: flex;
    }
  }
</style>

<script>
  // Hamburger toggle
  const hamburger = document.querySelector('.navbar__hamburger') as HTMLButtonElement;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement;

  hamburger?.addEventListener('click', () => {
    const isOpen = !mobileMenu.hidden;
    mobileMenu.hidden = isOpen;
    hamburger.setAttribute('aria-expanded', String(!isOpen));
  });

  // Dropdown keyboard
  document.querySelectorAll('.navbar__dropbtn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
    });
  });
</script>
